@model List<Web_Quản_Lí_Nhà_Thuốc.Models.Thuoc>
@{
    ViewData["Title"] = "Tra Cứu & Tư Vấn Thuốc Chuyên Nghiệp";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="page-title mb-1">Tra cứu & Tư vấn Y khoa</h1>
        <p class="text-muted mb-0">Tìm kiếm thuốc chống viết sai chính tả (Fuzzy Search), xem chỉ định, chống chỉ định và sơ đồ vị trí lưu trữ trên kệ.</p>
    </div>
    <div class="col-md-4">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0" id="search-addon"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="consultSearch" class="form-control border-start-0" placeholder="Nhập tên thuốc hoặc hoạt chất..." onkeyup="doFuzzySearch()" aria-describedby="search-addon" />
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Drug List Column -->
    <div class="col-md-4">
        <div class="dashboard-card p-3 h-100" style="max-height: 650px; overflow-y: auto;">
            <h5 class="fw-bold mb-3">Danh sách sản phẩm</h5>
            <div id="drugListContainer" class="list-group list-group-flush">
                @foreach (var d in Model)
                {
                    <a href="javascript:void(0);" onclick="loadDrugDetails(@d.MaThuoc)" class="list-group-item list-group-item-action border-0 py-3 mb-2 px-2.5 rounded-3 drug-item-link" id="link-@d.MaThuoc" style="border-radius: 8px;">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1 fw-bold text-dark">@d.TenThuoc</h6>
                            <small class="text-primary fw-bold">@string.Format("{0:N0}₫", d.DonGia)</small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="small text-muted"><i class="bi bi-capsule me-1"></i>@d.HoatChat</span>
                            <span class="badge bg-light text-secondary border">Kệ: @d.ViTriKe</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Drug Details & Shelf Locator Column -->
    <div class="col-md-8">
        <div id="noDetailsSelected" class="dashboard-card d-flex flex-column align-items-center justify-content-center py-5 h-100">
            <i class="bi bi-journal-medical text-muted mb-3" style="font-size: 4rem;"></i>
            <h5 class="fw-bold text-muted">Chọn một loại thuốc ở bên trái để xem thông tin tư vấn</h5>
            <p class="text-muted small">Thông tin bao gồm hoạt chất, liều dùng lâm sàng, chống chỉ định và định vị kệ thuốc.</p>
        </div>

        <div id="drugDetailsCard" class="dashboard-card p-4 h-100" style="display: none;">
            <!-- Drug Image + Header Row -->
            <div class="d-flex gap-3 border-bottom pb-3 mb-3">
                <!-- Drug Image (auto-loaded via NLM → RxNorm → OpenFDA cascade) -->
                <div class="drug-img-wrapper flex-shrink-0">
                    <div id="drugImgContainer" class="drug-img-box">
                        <div id="drugImgLoader" class="drug-img-loader">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        </div>
                        <img id="drugImgEl" src="" alt="" style="display:none; width:90px; height:90px; object-fit:contain; border-radius:10px; border:1px solid #e2e8f0;" />
                        <div id="drugImgPlaceholder" class="drug-img-placeholder">
                            <i class="bi bi-capsule"></i>
                        </div>
                    </div>
                    <!-- Source badge -->
                    <span id="drugImgSource" style="display:none; font-size:0.6rem; color:#64748b; background:#f1f5f9; border-radius:4px; padding:1px 5px; margin-top:3px; text-align:center; max-width:90px; word-break:break-word; line-height:1.3; display:none;"></span>
                </div>
                <!-- Drug Name + Info -->
                <div class="flex-grow-1">
                    <h3 id="detName" class="fw-bold text-primary mb-1">Tên Thuốc</h3>
                    <p class="mb-0 text-muted"><span class="fw-bold text-dark">Hoạt chất:</span> <span id="detHoatChat">Paracetamol</span></p>
                </div>
                <div class="text-end flex-shrink-0">
                    <span id="detPrice" class="h3 fw-bold text-dark">1,500₫</span>
                    <span class="text-muted d-block small">Giá cơ bản / <span id="detBaseUnit">Viên</span></span>
                </div>
            </div>

            <!-- Detail Tabs -->
            <ul class="nav nav-pills mb-3 gap-2" id="detailTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active btn-sm" style="border-radius: 8px;" id="info-tab" data-bs-toggle="pill" data-bs-target="#info-panel" type="button" role="tab">Chỉ Định & Liều Dùng</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link btn-sm" style="border-radius: 8px;" id="shelf-tab" data-bs-toggle="pill" data-bs-target="#shelf-panel" type="button" role="tab"><i class="bi bi-geo-fill me-1"></i>Vị Trí Kệ Thuốc</button>
                </li>
            </ul>

            <div class="tab-content mt-3" id="detailTabsContent">
                <!-- Info Panel -->
                <div class="tab-pane fade show active" id="info-panel" role="tabpanel">
                    <div class="mb-3">
                        <h6 class="fw-bold text-success"><i class="bi bi-check-circle me-1"></i> Công dụng & Chỉ định</h6>
                        <p id="detCongDung" class="text-dark bg-light p-3 rounded" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">Công dụng của thuốc...</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="fw-bold text-danger"><i class="bi bi-x-circle me-1"></i> Chống chỉ định</h6>
                        <p id="detChongChiDinh" class="text-dark bg-light p-3 rounded" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">Chống chỉ định...</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="fw-bold text-primary"><i class="bi bi-info-circle me-1"></i> Liều lượng & Hướng dẫn sử dụng</h6>
                        <p id="detLieuLuong" class="text-dark bg-light p-3 rounded" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">Hướng dẫn uống thuốc...</p>
                    </div>
                </div>

                <!-- Shelf Locator Panel -->
                <div class="tab-pane fade" id="shelf-panel" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold mb-0">Vị Trí Kệ Kho</h5>
                        <!-- Toggle 2D / 3D -->
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" id="btn2d" onclick="setShelfMode('2d')">
                                <i class="bi bi-grid me-1"></i>2D
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btn3d" onclick="setShelfMode('3d')">
                                <i class="bi bi-box me-1"></i>3D
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btnBoth" onclick="setShelfMode('both')">
                                <i class="bi bi-layout-split me-1"></i>Cả hai
                            </button>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Vị trí lưu kho: <strong class="text-dark" id="detViTriKeText">Kệ A - Tầng 2</strong></p>

                    <!-- 2D Shelf Grid -->
                    <div id="shelf2dView">
                        <div class="p-3 border rounded shadow-sm bg-light">
                            <h6 class="text-center fw-bold text-secondary mb-3 border-bottom pb-2">HỆ THỐNG KỆ KHO HÀNG</h6>
                            <div class="row g-2 mb-2 justify-content-center">
                                <div class="col-2 text-center align-self-center fw-bold text-secondary small">Kệ A</div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-A1" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 1</div></div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-A2" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 2</div></div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-A3" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 3</div></div>
                            </div>
                            <div class="row g-2 mb-2 justify-content-center">
                                <div class="col-2 text-center align-self-center fw-bold text-secondary small">Kệ B</div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-B1" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 1</div></div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-B2" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 2</div></div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-B3" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 3</div></div>
                            </div>
                            <div class="row g-2 mb-2 justify-content-center">
                                <div class="col-2 text-center align-self-center fw-bold text-secondary small">Kệ C</div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-C1" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 1</div></div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-C2" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 2</div></div>
                                <div class="col-3"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-C3" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Tầng 3</div></div>
                            </div>
                            <div class="row g-2 justify-content-center">
                                <div class="col-2 text-center align-self-center fw-bold text-secondary small">Khác</div>
                                <div class="col-9"><div class="shelf-cell d-flex align-items-center justify-content-center p-3 border text-center fw-bold" id="shelf2d-other" style="min-height:50px;background:#fff;border-radius:6px;font-size:.8rem;">Quầy Mỹ Phẩm / Tủ Lạnh</div></div>
                            </div>
                        </div>
                    </div>

                    <!-- 3D Warehouse Scene -->
                    <div class="warehouse-3d-scene mt-3">
                        <div class="scene-label">KHO DƯỢC PHẨM PharmaHub</div>
                        <div class="warehouse-3d">
                            <!-- Shelf A -->
                            <div class="shelf-unit-3d" id="unit-A">
                                <div class="shelf-label-3d">Kệ A</div>
                                <div class="shelf-floors">
                                    <div class="shelf-floor" id="shelf-A3">
                                        <div class="floor-front"><span>Tầng 3</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                    <div class="shelf-floor" id="shelf-A2">
                                        <div class="floor-front"><span>Tầng 2</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                    <div class="shelf-floor" id="shelf-A1">
                                        <div class="floor-front"><span>Tầng 1</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Shelf B -->
                            <div class="shelf-unit-3d" id="unit-B">
                                <div class="shelf-label-3d">Kệ B</div>
                                <div class="shelf-floors">
                                    <div class="shelf-floor" id="shelf-B3">
                                        <div class="floor-front"><span>Tầng 3</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                    <div class="shelf-floor" id="shelf-B2">
                                        <div class="floor-front"><span>Tầng 2</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                    <div class="shelf-floor" id="shelf-B1">
                                        <div class="floor-front"><span>Tầng 1</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Shelf C -->
                            <div class="shelf-unit-3d" id="unit-C">
                                <div class="shelf-label-3d">Kệ C</div>
                                <div class="shelf-floors">
                                    <div class="shelf-floor" id="shelf-C3">
                                        <div class="floor-front"><span>Tầng 3</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                    <div class="shelf-floor" id="shelf-C2">
                                        <div class="floor-front"><span>Tầng 2</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                    <div class="shelf-floor" id="shelf-C1">
                                        <div class="floor-front"><span>Tầng 1</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Special Zone -->
                            <div class="shelf-unit-3d shelf-unit-special" id="unit-other">
                                <div class="shelf-label-3d">Khu khác</div>
                                <div class="shelf-floors">
                                    <div class="shelf-floor shelf-floor-special" id="shelf-other">
                                        <div class="floor-front"><span>Quầy Mỹ Phẩm / Tủ Lạnh</span></div>
                                        <div class="floor-top"></div>
                                        <div class="floor-side"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Floor shadow -->
                        <div class="warehouse-floor"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ===== 3D WAREHOUSE STYLES ===== */
        .warehouse-3d-scene {
            background: linear-gradient(160deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            border-radius: 20px;
            padding: 28px 20px 20px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,0.4);
        }

        .warehouse-3d-scene::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at 50% 0%, rgba(13,148,136,0.12) 0%, transparent 65%);
            pointer-events: none;
        }

        .scene-label {
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .warehouse-3d {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 12px;
            perspective: 900px;
            padding-bottom: 10px;
            position: relative;
        }

        /* Each shelf unit */
        .shelf-unit-3d {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            transform-style: preserve-3d;
        }

        .shelf-label-3d {
            color: rgba(255,255,255,0.6);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .shelf-floors {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        /* Each floor (tầng) is a 3D box made with pseudo-elements */
        .shelf-floor {
            position: relative;
            width: 90px;
            height: 36px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .shelf-floor:hover {
            transform: scale(1.04);
        }

        .shelf-unit-special .shelf-floor {
            width: 110px;
            height: 60px;
        }

        /* Front face */
        .floor-front {
            position: absolute;
            inset: 0;
            background: linear-gradient(145deg, #2a3a4e, #1e2d3d);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.65);
            font-size: 0.65rem;
            font-weight: 600;
            text-align: center;
            padding: 4px;
            z-index: 2;
            transition: all 0.3s ease;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 2px 8px rgba(0,0,0,0.3);
        }

        /* Top face */
        .floor-top {
            position: absolute;
            width: 100%;
            height: 14px;
            background: linear-gradient(90deg, #3a5068, #2e4058);
            border-radius: 4px 4px 0 0;
            transform: rotateX(-45deg) translateY(-50%) scaleY(0.6);
            transform-origin: top center;
            top: 0;
            left: 0;
            z-index: 1;
            transition: all 0.3s ease;
        }

        /* Side face */
        .floor-side {
            position: absolute;
            width: 10px;
            height: 100%;
            background: linear-gradient(180deg, #1a2a3a, #0d1c29);
            right: -10px;
            top: 2px;
            transform: skewY(-45deg);
            z-index: 1;
            border-radius: 0 4px 4px 0;
            transition: all 0.3s ease;
        }

        /* ===== HIGHLIGHT STATE ===== */
        .shelf-floor.shelf-highlight .floor-front {
            background: linear-gradient(135deg, #0d9488, #14b8a6) !important;
            color: white !important;
            border-color: #2dd4bf !important;
            box-shadow: 0 0 20px rgba(13,148,136,0.8), inset 0 1px 0 rgba(255,255,255,0.3) !important;
            animation: shelf3d-glow 1.6s ease-in-out infinite !important;
        }
        .shelf-floor.shelf-highlight .floor-top {
            background: linear-gradient(90deg, #14b8a6, #0d9488) !important;
        }
        .shelf-floor.shelf-highlight .floor-side {
            background: linear-gradient(180deg, #0a7a70, #056860) !important;
        }

        @@keyframes shelf3d-glow {
            0%, 100% {
                box-shadow: 0 0 15px rgba(13,148,136,0.7), 0 0 30px rgba(13,148,136,0.3), inset 0 1px 0 rgba(255,255,255,0.3);
            }
            50% {
                box-shadow: 0 0 30px rgba(13,148,136,1), 0 0 60px rgba(13,148,136,0.5), 0 0 90px rgba(20,184,166,0.2), inset 0 1px 0 rgba(255,255,255,0.3);
            }
        }

        /* Floating drug icon on highlight */
        .shelf-floor.shelf-highlight .floor-front::after {
            content: '💊';
            position: absolute;
            top: -18px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 14px;
            animation: float-icon 1.5s ease-in-out infinite;
        }

        @@keyframes float-icon {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-5px); }
        }

        .warehouse-floor {
            height: 6px;
            background: linear-gradient(90deg, transparent, rgba(13,148,136,0.15), transparent);
            border-radius: 50%;
            margin: 0 10px;
            margin-top: 4px;
        }

        /* old 2D shelf compatibility */
        .drug-item-link.active {
            background-color: rgba(13, 148, 136, 0.08) !important;
            border-left: 4px solid var(--primary-color) !important;
        }

        /* 2D shelf highlight */
        .shelf-cell.shelf-highlight-2d {
            background-color: var(--primary-color, #0d9488) !important;
            color: white !important;
            border-color: var(--primary-color, #0d9488) !important;
            animation: pulse2d 1.4s ease-in-out infinite;
        }
        @@keyframes pulse2d {
            0%, 100% { box-shadow: 0 0 0 0 rgba(13,148,136,0.7); }
            50% { box-shadow: 0 0 0 8px rgba(13,148,136,0); }
        }

        /* Drug image box */
        .drug-img-box {
            width: 90px; height: 90px;
            border-radius: 12px;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
            position: relative;
        }
        .drug-img-placeholder {
            color: #94a3b8;
            font-size: 2.5rem;
        }
        .drug-img-loader {
            position: absolute; inset:0;
            display:flex; align-items:center; justify-content:center;
            background: rgba(248,250,252,0.8);
        }
    </style>
    <script>
        var currentDrugs = @Html.Raw(Json.Serialize(Model));
        var currentShelfMode = '2d'; // default show 2D

        document.addEventListener('DOMContentLoaded', function() {
            setShelfMode('2d'); // default
        });

        // Toggle 2D / 3D / Both shelf views
        function setShelfMode(mode) {
            currentShelfMode = mode;
            var view2d = document.getElementById('shelf2dView');
            var view3d = document.querySelector('.warehouse-3d-scene');

            document.getElementById('btn2d').classList.remove('active');
            document.getElementById('btn3d').classList.remove('active');
            document.getElementById('btnBoth').classList.remove('active');

            if (mode === '2d') {
                if (view2d) view2d.style.display = 'block';
                if (view3d) view3d.style.display = 'none';
                document.getElementById('btn2d').classList.add('active');
            } else if (mode === '3d') {
                if (view2d) view2d.style.display = 'none';
                if (view3d) view3d.style.display = 'block';
                document.getElementById('btn3d').classList.add('active');
            } else { // both
                if (view2d) view2d.style.display = 'block';
                if (view3d) view3d.style.display = 'block';
                document.getElementById('btnBoth').classList.add('active');
            }
        }

        // ── Load drug image: cascade through 3 API tiers on server ──────
        function loadDrugImage(drugName, hoatChat) {
            var imgEl       = document.getElementById('drugImgEl');
            var loader      = document.getElementById('drugImgLoader');
            var placeholder = document.getElementById('drugImgPlaceholder');
            var srcBadge    = document.getElementById('drugImgSource');

            // Reset state
            imgEl.style.display       = 'none';
            placeholder.style.display = 'flex';
            loader.style.display      = 'flex';
            if (srcBadge) srcBadge.style.display = 'none';

            // Attempt 1: search by drug trade name
            fetch('/Pharmacist/GetDrugImage?name=' + encodeURIComponent(drugName))
                .then(r => r.json())
                .then(data => {
                    if (data && data.imageUrl) {
                        _showDrugImage(data.imageUrl, data.source);
                    } else if (hoatChat && hoatChat !== drugName) {
                        // Attempt 2: retry with active ingredient (hoạt chất)
                        return fetch('/Pharmacist/GetDrugImage?name=' + encodeURIComponent(hoatChat))
                            .then(r2 => r2.json())
                            .then(data2 => {
                                if (data2 && data2.imageUrl) {
                                    _showDrugImage(data2.imageUrl, (data2.source || 'API') + ' (hoạt chất)');
                                } else {
                                    _showPlaceholder();
                                }
                            });
                    } else {
                        _showPlaceholder();
                    }
                })
                .catch(() => _showPlaceholder());
        }

        function _showDrugImage(url, source) {
            var imgEl    = document.getElementById('drugImgEl');
            var loader   = document.getElementById('drugImgLoader');
            var pholder  = document.getElementById('drugImgPlaceholder');
            var srcBadge = document.getElementById('drugImgSource');

            loader.style.display  = 'none';
            pholder.style.display = 'none';

            // Test if image actually loads (avoid broken images)
            var testImg = new Image();
            testImg.onload = function() {
                imgEl.src = url;
                imgEl.style.display = 'block';
                if (srcBadge && source) {
                    srcBadge.innerText = '📡 ' + source;
                    srcBadge.style.display = 'inline-block';
                }
            };
            testImg.onerror = function() { _showPlaceholder(); };
            testImg.src = url;
        }

        function _showPlaceholder() {
            var loader   = document.getElementById('drugImgLoader');
            var pholder  = document.getElementById('drugImgPlaceholder');
            if (loader) loader.style.display = 'none';
            if (pholder) pholder.style.display = 'flex';
        }

        function loadDrugDetails(id) {
            var drug = currentDrugs.find(d => d.maThuoc === id);
            if (!drug) return;

            // Highlight side item
            document.querySelectorAll(".drug-item-link").forEach(l => l.classList.remove("active"));
            var activeLink = document.getElementById("link-" + id);
            if (activeLink) activeLink.classList.add("active");

            // Fill card values
            document.getElementById("detName").innerText = drug.tenThuoc;
            document.getElementById("detHoatChat").innerText = drug.hoatChat || "Không có";
            document.getElementById("detPrice").innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(drug.donGia);
            document.getElementById("detBaseUnit").innerText = drug.donViCoBan;

            document.getElementById("detCongDung").innerText = drug.congDung || "Chưa có thông tin.";
            document.getElementById("detChongChiDinh").innerText = drug.chongChiDinh || "Không có chống chỉ định.";
            document.getElementById("detLieuLuong").innerText = drug.lieuLuong || "Uống theo chỉ định.";

            document.getElementById("detViTriKeText").innerText = drug.viTriKe || "Chưa thiết lập";

            // Load drug image automatically (pass hoatChat for Tier-2 retry)
            loadDrugImage(drug.tenThuoc, drug.hoatChat);

            // Highlight both 2D and 3D shelves
            document.querySelectorAll(".shelf-floor").forEach(c => c.classList.remove("shelf-highlight"));
            document.querySelectorAll(".shelf-cell").forEach(c => c.classList.remove("shelf-highlight-2d"));

            var loc = (drug.viTriKe || "").toLowerCase();
            var targetKey = "other";

            if (loc.includes("kệ a") && loc.includes("tầng 1")) targetKey = "A1";
            else if (loc.includes("kệ a") && loc.includes("tầng 2")) targetKey = "A2";
            else if (loc.includes("kệ a") && loc.includes("tầng 3")) targetKey = "A3";
            else if (loc.includes("kệ b") && loc.includes("tầng 1")) targetKey = "B1";
            else if (loc.includes("kệ b") && loc.includes("tầng 2")) targetKey = "B2";
            else if (loc.includes("kệ b") && loc.includes("tầng 3")) targetKey = "B3";
            else if (loc.includes("kệ c") && loc.includes("tầng 1")) targetKey = "C1";
            else if (loc.includes("kệ c") && loc.includes("tầng 2")) targetKey = "C2";
            else if (loc.includes("kệ c") && loc.includes("tầng 3")) targetKey = "C3";
            else if (loc.includes("mỹ phẩm") || loc.includes("tủ lạnh") || loc.includes("quầy")) targetKey = "other";

            // 3D highlight
            var cell3d = document.getElementById("shelf-" + targetKey);
            if (cell3d) cell3d.classList.add("shelf-highlight");

            // 2D highlight
            var cell2d = document.getElementById("shelf2d-" + targetKey);
            if (cell2d) cell2d.classList.add("shelf-highlight-2d");

            // Display card, show info tab first
            document.getElementById("noDetailsSelected").style.display = "none";
            document.getElementById("drugDetailsCard").style.display = "block";
            var infoTab = document.getElementById("info-tab");
            new bootstrap.Tab(infoTab).show();
        }

        function doFuzzySearch() {
            var q = document.getElementById("consultSearch").value;
            fetch('/Pharmacist/SearchDrugs?query=' + encodeURIComponent(q))
                .then(res => res.json())
                .then(data => {
                    var container = document.getElementById("drugListContainer");
                    container.innerHTML = "";

                    if (data.length === 0) {
                        container.innerHTML = "<div class='text-muted small text-center py-4'>Không tìm thấy thuốc nào khớp.</div>";
                        return;
                    }

                    data.forEach(function(item) {
                        var price = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.donGia);
                        var activeClass = document.getElementById("drugDetailsCard").style.display === "block" && 
                                          document.getElementById("detName").innerText === item.tenThuoc ? "active" : "";

                        var html = `
                            <a href="javascript:void(0);" onclick="loadDrugDetails(${item.maThuoc})" class="list-group-item list-group-item-action border-0 py-3 mb-2 px-2.5 rounded-3 drug-item-link ${activeClass}" id="link-${item.maThuoc}">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold text-dark">${item.tenThuoc}</h6>
                                    <small class="text-primary fw-bold">${price}</small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="small text-muted"><i class="bi bi-capsule me-1"></i>${item.hoatChat || "N/A"}</span>
                                    <span class="badge bg-light text-secondary border">Kệ: ${item.viTriKe || "Chưa rõ"}</span>
                                </div>
                            </a>`;
                        container.innerHTML += html;
                    });
                });
        }
    </script>
}
