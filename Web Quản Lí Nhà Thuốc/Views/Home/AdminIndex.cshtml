@inject Web_Quản_Lí_Nhà_Thuốc.Data.PharmacyDbContext DbContext
@{
    ViewData["Title"] = "Dashboard Tổng Quan";
    var pendingPrescriptions = DbContext.DonThuocs.Count(d => d.TrangThai == "ChoDuyet");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Tổng quan hệ thống</h1>
    <div>
        <button class="btn btn-outline-secondary me-2"><i class="bi bi-download me-1"></i> Xuất báo cáo</button>
        <button class="btn" style="background-color: var(--primary-color); color: white;"><i class="bi bi-plus-lg me-1"></i> Tạo đơn hàng</button>
    </div>
</div>

<!-- Dashboard Widgets -->
<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-card">
            <div class="card-icon icon-blue">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div class="card-title">Doanh thu hôm nay</div>
            <div class="card-value">12,450,000₫</div>
            <div class="card-trend trend-up">
                <i class="bi bi-arrow-up-right"></i>
                <span>+15.3% so với hôm qua</span>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-card">
            <div class="card-icon icon-green">
                <i class="bi bi-cart-check"></i>
            </div>
            <div class="card-title">Đơn hàng mới</div>
            <div class="card-value">145</div>
            <div class="card-trend trend-up">
                <i class="bi bi-arrow-up-right"></i>
                <span>+5.2% so với hôm qua</span>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-sm-6 col-xl-3">
        <a href="/Pharmacist/Prescriptions" class="text-decoration-none">
            <div class="dashboard-card" style="cursor: pointer; border-left: 4px solid var(--amber-primary, #f59e0b);">
                <div class="card-icon" style="background-color: #fef3c7; color: #d97706;">
                    <i class="bi bi-file-earmark-medical"></i>
                </div>
                <div class="card-title">Yêu cầu tư vấn chờ duyệt</div>
                <div class="card-value text-dark">@pendingPrescriptions</div>
                <div class="card-trend text-warning">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Cần duyệt gấp</span>
                </div>
            </div>
        </a>
    </div>
    
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-card">
            <div class="card-icon icon-purple">
                <i class="bi bi-people"></i>
            </div>
            <div class="card-title">Khách hàng mới</div>
            <div class="card-value">38</div>
            <div class="card-trend trend-up">
                <i class="bi bi-arrow-up-right"></i>
                <span>+12.5% tuần này</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts & Data -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="dashboard-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Biểu đồ doanh thu tuần</h5>
                <select class="form-select form-select-sm" style="width: auto;">
                    <option>Tuần này</option>
                    <option>Tháng này</option>
                    <option>Năm nay</option>
                </select>
            </div>
            <div style="height: 300px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-lg-4">
        <div class="dashboard-card h-100">
            <h5 class="fw-bold mb-4">Hoạt động gần đây</h5>
            <div class="d-flex align-items-start mb-3">
                <div class="me-3 text-primary"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i></div>
                <div>
                    <div class="fw-semibold">Nhập kho thành công</div>
                    <div class="text-muted small">Lô thuốc Panadol Extra (50 hộp)</div>
                    <div class="text-muted small mt-1">10 phút trước</div>
                </div>
            </div>
            <div class="d-flex align-items-start mb-3">
                <div class="me-3 text-success"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i></div>
                <div>
                    <div class="fw-semibold">Đơn hàng mới #1024</div>
                    <div class="text-muted small">Khách hàng: Nguyễn Văn A - 245,000₫</div>
                    <div class="text-muted small mt-1">35 phút trước</div>
                </div>
            </div>
            <div class="d-flex align-items-start mb-3">
                <div class="me-3 text-warning"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i></div>
                <div>
                    <div class="fw-semibold">Cảnh báo tồn kho</div>
                    <div class="text-muted small">Vitamin C 500mg chỉ còn 5 hộp</div>
                    <div class="text-muted small mt-1">2 giờ trước</div>
                </div>
            </div>
            <button class="btn btn-outline-primary w-100 mt-3">Xem tất cả hoạt động</button>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="custom-table-container">
    <div class="custom-table-header">
        <h5 class="fw-bold mb-0">Đơn hàng gần đây</h5>
        <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-sm" placeholder="Tìm mã đơn...">
            <button class="btn btn-sm btn-outline-secondary">Lọc <i class="bi bi-funnel"></i></button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách Hàng</th>
                    <th>Ngày Lập</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">#ORD-1025</td>
                    <td>Trần Thị B</td>
                    <td>Hôm nay, 14:30</td>
                    <td class="fw-bold text-dark">520,000₫</td>
                    <td><span class="badge-status status-completed">Hoàn thành</span></td>
                    <td>
                        <button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">#ORD-1024</td>
                    <td>Nguyễn Văn A</td>
                    <td>Hôm nay, 13:45</td>
                    <td class="fw-bold text-dark">245,000₫</td>
                    <td><span class="badge-status status-completed">Hoàn thành</span></td>
                    <td>
                        <button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">#ORD-1023</td>
                    <td>Lê Hoàng C</td>
                    <td>Hôm nay, 11:20</td>
                    <td class="fw-bold text-dark">1,250,000₫</td>
                    <td><span class="badge-status status-pending">Đang giao</span></td>
                    <td>
                        <button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">#ORD-1022</td>
                    <td>Khách vãng lai</td>
                    <td>Hôm nay, 09:15</td>
                    <td class="fw-bold text-dark">85,000₫</td>
                    <td><span class="badge-status status-completed">Hoàn thành</span></td>
                    <td>
                        <button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">#ORD-1021</td>
                    <td>Phạm Văn D</td>
                    <td>Hôm qua, 16:40</td>
                    <td class="fw-bold text-dark">320,000₫</td>
                    <td><span class="badge-status status-cancelled">Đã hủy</span></td>
                    <td>
                        <button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Init Chart.js for Revenue Chart
        const ctx = document.getElementById('revenueChart').getContext('2d');
        
        // Gradient for the line chart area
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(13, 148, 136, 0.5)'); // Medical Teal opacity
        gradient.addColorStop(1, 'rgba(13, 148, 136, 0.0)');
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: [8500000, 10200000, 9100000, 11500000, 10800000, 14200000, 12450000],
                    borderColor: '#0d9488',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#0d9488',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4 // Makes the line smooth
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 12,
                        titleFont: { size: 13, family: 'Inter' },
                        bodyFont: { size: 14, family: 'Inter', weight: 'bold' },
                        displayColors: false,
                        callbacks: {
                            label: function(context) {
                                let value = context.raw || 0;
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#f1f5f9',
                            drawBorder: false
                        },
                        ticks: {
                            font: { family: 'Inter', size: 12 },
                            color: '#64748b',
                            callback: function(value) {
                                return (value / 1000000) + 'M'; // Format as millions
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            font: { family: 'Inter', size: 12 },
                            color: '#64748b'
                        }
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
            }
        });
    </script>
}
