                    <div class="d-flex align-items-center bg-white p-3 rounded-3 shadow-2xs h-100">
                        <div class="text-teal me-3 bg-teal bg-opacity-10 p-2.5 rounded-circle"><i class="bi bi-truck fs-4"></i></div>
                        <div>
                            <div class="fw-bold text-dark small">Miễn phí vận chuyển</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Đơn hàng từ 150.000₫</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
