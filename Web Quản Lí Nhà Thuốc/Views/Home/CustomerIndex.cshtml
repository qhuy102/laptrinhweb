@model IEnumerable<Web_Quản_Lí_Nhà_Thuốc.Models.Thuoc>
@{
    ViewData["Title"] = "Trang chủ - Nhà Thuốc Trực Tuyến";
}

<!-- Hero Section -->
<div class="hero-section text-white rounded-4 p-5 mb-5 shadow-sm overflow-hidden position-relative">
    <div class="hero-content position-relative" style="z-index: 2; max-width: 600px;">
        <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-2 mb-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.8rem; backdrop-filter: blur(5px);">
            Nhà Thuốc PharmaCare
        </span>
        <h1 class="display-4 fw-bold mb-3">Chăm Sóc Sức Khỏe Gia Đình Bạn</h1>
        <p class="lead text-white text-opacity-90 mb-4">Cung cấp thuốc chính hãng, dược mỹ phẩm cao cấp và thiết bị y tế với đội ngũ dược sĩ tư vấn tận tình 24/7.</p>
        <div class="d-flex gap-3 flex-wrap">
            <a href="#san-pham" class="btn btn-light btn-lg px-4 py-2.5 fw-bold text-teal" style="border-radius: 12px;">Mua thuốc ngay</a>
            <a href="/Identity/Account/Register" class="btn btn-outline-light btn-lg px-4 py-2.5 fw-semibold" style="border-radius: 12px; backdrop-filter: blur(5px);">Đăng ký Hội viên</a>
        </div>
    </div>
    <div class="hero-pattern"></div>
</div>

<!-- Membership Benefits Section -->
<div class="card border-0 shadow-sm mb-5 p-4" style="border-radius: 20px; background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%);">
    <div class="row align-items-center">
        <div class="col-12 col-md-3 text-center text-md-start mb-3 mb-md-0">
            <span class="badge bg-teal text-white rounded-pill px-3 py-1.5 mb-2 fw-medium" style="background-color: var(--primary-color);">ĐẶC QUYỀN VIP</span>
            <h4 class="fw-bold text-dark mb-0">Hội Viên PharmaCare</h4>
            <p class="text-muted small mb-0">Đăng ký miễn phí - Nhận ngàn ưu đãi</p>
        </div>
        <div class="col-12 col-md-9">
            <div class="row g-3">
                <div class="col-12 col-sm-4">
                    <div class="d-flex align-items-center bg-white p-3 rounded-3 shadow-2xs h-100">
                        <div class="text-teal me-3 bg-teal bg-opacity-10 p-2.5 rounded-circle"><i class="bi bi-truck fs-4"></i></div>
                        <div>
                            <div class="fw-bold text-dark small">Miễn phí vận chuyển</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Đơn hàng từ 150.000₫</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="d-flex align-items-center bg-white p-3 rounded-3 shadow-2xs h-100">
                        <div class="text-success me-3 bg-success bg-opacity-10 p-2.5 rounded-circle"><i class="bi bi-gift fs-4"></i></div>
                        <div>
                            <div class="fw-bold text-dark small">Tích điểm 2%</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Khấu trừ đơn hàng sau</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="d-flex align-items-center bg-white p-3 rounded-3 shadow-2xs h-100">
                        <div class="text-warning me-3 bg-warning bg-opacity-10 p-2.5 rounded-circle"><i class="bi bi-shield-check fs-4"></i></div>
                        <div>
                            <div class="fw-bold text-dark small">100% Chính hãng</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Đổi trả dễ dàng 30 ngày</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Products Grid Section -->
<div id="san-pham" class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Sản phẩm nổi bật</h2>
            <p class="text-muted small mb-0">Thuốc bán chạy và khuyên dùng bởi chuyên gia y tế</p>
        </div>
        <a href="#" class="text-teal fw-semibold text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
    </div>

    <!-- Category Tabs -->
    <div class="d-flex gap-2 overflow-x-auto pb-3 mb-4 scrollbar-hidden">
        <button class="btn btn-teal-active px-4 py-2 text-nowrap rounded-pill">Tất cả sản phẩm</button>
        <button class="btn btn-outline-secondary px-4 py-2 text-nowrap rounded-pill">Thuốc kê đơn</button>
        <button class="btn btn-outline-secondary px-4 py-2 text-nowrap rounded-pill">Không kê đơn</button>
        <button class="btn btn-outline-secondary px-4 py-2 text-nowrap rounded-pill">Thực phẩm chức năng</button>
        <button class="btn btn-outline-secondary px-4 py-2 text-nowrap rounded-pill">Dược mỹ phẩm</button>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-light rounded-4">
            <div class="text-muted mb-3"><i class="bi bi-capsule fs-1"></i></div>
            <h5 class="fw-bold text-dark">Hiện chưa có sản phẩm nào trong kho</h5>
            <p class="text-muted small">Vui lòng quay lại sau hoặc liên hệ quản trị viên.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card border-0 shadow-2xs h-100 overflow-hidden" style="border-radius: 16px;">
                        <!-- Product Image -->
                        <div class="product-img-wrapper bg-light text-center p-4 position-relative">
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="@item.HinhAnh" alt="@item.TenThuoc" class="img-fluid product-img">
                            }
                            else
                            {
                                <div class="text-teal bg-teal bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center mx-auto" style="width: 120px; height: 120px;">
                                    <i class="bi bi-capsule-capsules fs-1"></i>
                                </div>
                            }
                            <span class="badge bg-teal bg-opacity-10 text-teal rounded-pill px-2.5 py-1 position-absolute top-0 start-0 m-3 small border border-teal-subtle">
                                @(item.LoaiThuoc?.TenLoai ?? "Thuốc")
                            </span>
                        </div>

                        <!-- Product Content -->
                        <div class="card-body p-3.5 d-flex flex-column">
                            <h6 class="fw-bold text-dark mb-1 text-truncate-2">@item.TenThuoc</h6>
                            <p class="text-muted small mb-3 text-truncate-2 flex-grow-1">@(item.MoTa ?? "Không có mô tả sản phẩm.")</p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <div>
                                    <div class="text-muted small" style="font-size: 0.7rem;">Giá bán</div>
                                    <div class="fw-bold text-dark fs-5">@item.DonGia.ToString("#,##0")₫</div>
                                </div>
                                @if (item.SoLuong > 0)
                                {
                                    <button class="btn btn-teal-btn rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-cart-plus fs-5"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 small border border-danger-subtle">Hết hàng</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Styling variables specifically for customer storefront */
    :root {
        --primary-color: #0d9488;
        --primary-hover: #0f766e;
    }

    .text-teal {
        color: var(--primary-color) !important;
    }
    
    .bg-teal {
        background-color: var(--primary-color) !important;
    }

    .border-teal-subtle {
        border-color: rgba(13, 148, 136, 0.2) !important;
    }

    /* Hero Section styling */
    .hero-section {
        background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
        box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15) !important;
    }

    .hero-pattern {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background-image: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0) 50%);
        pointer-events: none;
    }

    /* Product Card styling */
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #f1f5f9 !important;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08), 0 8px 8px -5px rgba(0, 0, 0, 0.04) !important;
    }

    .product-img {
        max-height: 120px;
        object-fit: contain;
    }

    .product-img-wrapper {
        border-bottom: 1px solid #f8fafc;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Tabs styling */
    .btn-teal-active {
        background-color: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }
    
    .btn-teal-active:hover {
        background-color: var(--primary-hover);
        color: white;
    }

    .btn-teal-btn {
        background-color: var(--primary-color);
        color: white;
        border: none;
        transition: background-color 0.2s;
    }

    .btn-teal-btn:hover {
        background-color: var(--primary-hover);
    }

    .scrollbar-hidden::-webkit-scrollbar {
        display: none;
    }
    
    .scrollbar-hidden {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .shadow-2xs {
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
</style>
