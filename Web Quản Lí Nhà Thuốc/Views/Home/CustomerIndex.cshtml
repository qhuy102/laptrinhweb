<!-- Products Grid Section -->
<div id="san-pham" class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Sản phẩm nổi bật</h2>
            <p class="text-muted small mb-0">Thuốc bán chạy và khuyên dùng bởi chuyên gia y tế</p>
        </div>
        <a href="#" class="text-teal fw-semibold text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
    </div>

    <!-- Category Tabs -->
    <div class="d-flex gap-2 overflow-x-auto pb-2 mb-2 scrollbar-hidden">
        <button class="btn btn-teal-active category-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('category', 'All', this)">Tất cả danh mục</button>
        <button class="btn btn-outline-secondary category-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('category', 'Thuốc kê đơn', this)">Thuốc kê đơn</button>
        <button class="btn btn-outline-secondary category-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('category', 'Thuốc không kê đơn', this)">Không kê đơn</button>
        <button class="btn btn-outline-secondary category-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('category', 'Thực phẩm chức năng', this)">Thực phẩm chức năng</button>
        <button class="btn btn-outline-secondary category-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('category', 'Dược mỹ phẩm', this)">Dược mỹ phẩm</button>
    </div>

    <!-- Treatment Group Tabs -->
    <div class="d-flex gap-2 overflow-x-auto pb-3 mb-4 scrollbar-hidden">
        <button class="btn btn-teal-active treatment-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('treatment', 'All', this)">Tất cả nhóm bệnh</button>
        <button class="btn btn-outline-secondary treatment-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('treatment', 'Hạ sốt - Giảm đau', this)">Hạ sốt - Giảm đau</button>
        <button class="btn btn-outline-secondary treatment-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('treatment', 'Hô hấp - Cảm cúm', this)">Hô hấp - Cảm cúm</button>
        <button class="btn btn-outline-secondary treatment-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('treatment', 'Kháng sinh - Kháng viêm', this)">Kháng sinh - Kháng viêm</button>
        <button class="btn btn-outline-secondary treatment-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('treatment', 'Bổ sung đề kháng - Vitamin', this)">Bổ sung đề kháng - Vitamin</button>
        <button class="btn btn-outline-secondary treatment-filter-btn px-4 py-2 text-nowrap rounded-pill" onclick="filterProducts('treatment', 'Chăm sóc da - Dược mỹ phẩm', this)">Chăm sóc da - Dược mỹ phẩm</button>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-light rounded-4">
            <div class="text-muted mb-3"><i class="bi bi-capsule fs-1"></i></div>
            <h5 class="fw-bold text-dark">Hiện chưa có sản phẩm nào trong kho</h5>
            <p class="text-muted small">Vui lòng quay lại sau hoặc liên hệ quản trị viên.</p>
        </div>
    }
    else
    {
        <div class="row g-4" id="productGrid">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 product-item-card" data-category="@(item.LoaiThuoc?.TenLoai ?? "")" data-treatment="@(item.NhomDieuTri ?? "")">
                    @await Html.PartialAsync("~/Views/Shared/_ProductCard.cshtml", item)
                </div>
            }
        </div>
    }
</div>

<!-- Daily Deals Section -->
@{
    var dealProducts = ViewBag.DealProducts as List<Web_Quản_Lí_Nhà_Thuốc.Models.Thuoc> ?? new List<Web_Quản_Lí_Nhà_Thuốc.Models.Thuoc>();
}
@if (dealProducts.Any())
{
    <div class="daily-deals-section mb-5 p-4 p-md-5 rounded-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); box-shadow: 0 20px 40px rgba(15, 23, 42, 0.15); margin-top: 2rem;">
        <div class="position-absolute top-0 end-0 p-3 opacity-10" style="font-size: 10rem; color: #2dd4bf; transform: translate(30px, -30px); pointer-events: none;">
            <i class="bi bi-percent"></i>
        </div>
        
        <div class="row align-items-center mb-4 g-3 position-relative z-2">
            <div class="col-md-6 text-center text-md-start">
                <span class="badge bg-danger rounded-pill px-3 py-1.5 mb-2 animate-pulse fw-bold"><i class="bi bi-fire me-1"></i>GIỜ VÀNG GIÁ SỐC</span>
                <h2 class="fw-bold text-white mb-0">Ưu đãi thuốc trong ngày</h2>
                <p class="text-slate-400 small mb-0 mt-1">Chương trình ưu đãi sức khỏe đặc biệt chỉ áp dụng trong ngày hôm nay.</p>
            </div>
            <div class="col-md-6 d-flex justify-content-center justify-content-md-end align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-white small fw-medium">Kết thúc trong:</span>
                    <div class="d-flex align-items-center gap-1.5" id="dealCountdown">
                        <div class="countdown-box" id="countdown-hours">04</div>
                        <span class="text-teal font-monospace fw-bold">:</span>
                        <div class="countdown-box" id="countdown-minutes">32</div>
                        <span class="text-teal font-monospace fw-bold">:</span>
                        <div class="countdown-box" id="countdown-seconds">15</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 position-relative z-2">
            @for (int i = 0; i < dealProducts.Count; i++)
            {
                var item = dealProducts[i];
                var discountPercent = item.DiscountPercent;
                var salePrice = item.GiaHienTai;
                var soldPercentage = item.SoLuong > 0 ? (int)(100 - (item.SoLuong * 100 / (item.SoLuong + 25))) : 100;
                if (soldPercentage < 20) soldPercentage = 25; // look nice
                var itemsLeft = item.SoLuong;

                <div class="col-12 col-md-4">
                    <div class="card border-0 rounded-3 overflow-hidden h-100 daily-deal-card bg-slate-800 text-white">
                        <div class="position-relative">
                            <span class="badge bg-danger position-absolute top-3 start-3 z-3 py-1.5 px-2.5 rounded-3 fw-bold" style="font-size: 0.85rem;">Giảm @discountPercent%</span>
                            
                            <!-- Product Image Area with API Cascade -->
                            <div class="drug-img-area text-center bg-white p-4 position-relative d-flex align-items-center justify-content-center" 
                                 style="height: 180px;" 
                                 data-drug-name="@item.TenThuoc" 
                                 data-hoatChat="@item.HoatChat">
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img class="img-fluid product-img drug-loaded-img" src="@item.HinhAnh" alt="@item.TenThuoc" style="max-height: 140px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="drug-spinner spinner-border text-teal position-absolute" role="status" style="width: 2rem; height: 2rem;"></div>
                                    <img class="img-fluid drug-loaded-img" src="" alt="@item.TenThuoc" style="max-height: 140px; display: none; object-fit: contain;">
                                    <div class="drug-placeholder d-none align-items-center justify-content-center text-muted" style="width: 100%; height: 100%;">
                                        <i class="bi bi-capsule fs-1"></i>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-teal bg-opacity-20 text-teal mb-2 font-monospace px-2 py-1" style="font-size: 0.72rem; font-weight: 500;">@item.LoaiThuoc?.TenLoai</span>
                                <h6 class="fw-bold text-white text-truncate mb-1">@item.TenThuoc</h6>
                                <p class="text-slate-400 small text-truncate mb-3" style="font-size: 0.78rem;">H/C: @(item.HoatChat ?? "Xem chi tiết")</p>
                                
                                <div class="d-flex align-items-baseline gap-2 mb-3">
                                    <span class="fs-4 fw-extrabold text-teal">@salePrice.ToString("N0") đ</span>
                                    <span class="text-slate-500 text-decoration-line-through small" style="font-size:0.82rem;">@item.DonGia.ToString("N0") đ</span>
                                </div>
                            </div>

                            <div>
                                <!-- Stock Progress Bar -->
                                <div class="d-flex justify-content-between align-items-center mb-1.5 small text-slate-400">
                                    <span>Đã bán @soldPercentage%</span>
                                    <span class="text-danger fw-semibold">Còn @itemsLeft sản phẩm</span>
                                </div>
                                <div class="progress bg-slate-700 mb-3" style="height: 6px; border-radius: 4px;">
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: @soldPercentage%; border-radius: 4px;" aria-valuenow="@soldPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>

                                <a href="/Cart/AddToCart/@item.MaThuoc" class="btn btn-teal-btn w-100 py-2.5 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2 mt-2">
                                    <i class="bi bi-cart-plus-fill fs-5"></i> Thêm vào giỏ hàng
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Auto-load drug images via API cascade -->
<script>
(function() {
    // Cache to avoid duplicate API calls for same drug name
    var imgCache = {};

    function loadImgForArea(area) {
        if (area.dataset.loaded) return;
        area.dataset.loaded = '1';

        var drugName = area.dataset.drugName || '';
        var hoatChat = area.dataset.hoatChat || '';
        var spinner  = area.querySelector('.drug-spinner');
        var imgEl    = area.querySelector('.drug-loaded-img');
        var holder   = area.querySelector('.drug-placeholder');

        if (!imgEl || imgEl.getAttribute('src')) return; // has manual image already — skip

        function showImg(url) {
            var testImg = new Image();
            testImg.referrerPolicy = "no-referrer";
            testImg.onload = function() {
                if (spinner) spinner.style.display = 'none';
                imgEl.referrerPolicy = "no-referrer";
                imgEl.src = url;
                imgEl.style.display = 'block';
                if (holder) holder.style.display = 'none';
            };
            testImg.onerror = function() { showPlaceholder(); };
            testImg.src = url;
        }

        function showPlaceholder() {
            if (spinner) spinner.style.display = 'none';
            if (holder) { holder.style.display = 'flex'; holder.style.removeProperty('display'); holder.style.display = 'flex'; }
        }

        function tryFetch(name, fallbackName) {
            if (imgCache[name] !== undefined) {
                if (imgCache[name]) showImg(imgCache[name]);
                else showPlaceholder();
                return;
            }

            // Map Vietnamese brands to Wikipedia English terms that GUARANTEE images
            var lowerName = name.toLowerCase();
            var searchStr = name;
            
            if (lowerName.includes('panadol') || lowerName.includes('paracetamol') || lowerName.includes('hapacol') || lowerName.includes('decolgen')) {
                searchStr = 'tylenol';
            } else if (lowerName.includes('vitamin c') || lowerName.includes('enervon')) {
                searchStr = 'ascorbic acid';
            } else if (lowerName.includes('cetaphil')) {
                searchStr = 'cetaphil';
            } else if (lowerName.includes('amoxicillin')) {
                searchStr = 'amoxil';
            } else {
                // Strip dosage for better match
                searchStr = name.replace(/\s+\d+\s*(mg|ml|g|mcg|iu|%|UI)\b.*/gi, '').trim();
            }

            // Call Wikipedia API directly from the browser (Bypasses Backend DNS/SSL/Firewall issues)
            var wikiUrl = 'https://en.wikipedia.org/w/api.php?action=query&format=json&origin=*&prop=pageimages&generator=search&gsrsearch=' + encodeURIComponent(searchStr) + '&pithumbsize=500';

            fetch(wikiUrl)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.query && data.query.pages) {
                        var pages = data.query.pages;
                        var firstPageId = Object.keys(pages)[0];
                        if (pages[firstPageId] && pages[firstPageId].thumbnail && pages[firstPageId].thumbnail.source) {
                            var imgUrl = pages[firstPageId].thumbnail.source;
                            imgCache[name] = imgUrl;
                            showImg(imgUrl);
                            return;
                        }
                    }
                    
                    // Fallback to Backend Local DB if Wikipedia fails
                    fetch('/Pharmacist/GetDrugImage?name=' + encodeURIComponent(name))
                        .then(function(r2) { return r2.json(); })
                        .then(function(d2) {
                            if (d2 && d2.imageUrl) {
                                imgCache[name] = d2.imageUrl;
                                showImg(d2.imageUrl);
                            } else {
                                imgCache[name] = null;
                                showPlaceholder();
                            }
                        }).catch(function() { showPlaceholder(); });
                })
                .catch(function() { 
                    showPlaceholder(); 
                });
        }

        tryFetch(drugName, hoatChat);
    }

    // Use IntersectionObserver for lazy loading (only fetch images when visible)
    if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    loadImgForArea(entry.target);
                    observer.unobserve(entry.target);
                }
            });
        }, { rootMargin: '100px' });

        document.querySelectorAll('.drug-img-area[data-drug-name]').forEach(function(el) {
            observer.observe(el);
        });
    } else {
        // Fallback: load all immediately
        document.querySelectorAll('.drug-img-area[data-drug-name]').forEach(function(el) {
            loadImgForArea(el);
        });
    }
})();

var activeCategory = 'All';
var activeTreatment = 'All';

function filterProducts(type, value, btn) {
    if (type === 'category') {
        activeCategory = value;
        document.querySelectorAll('.category-filter-btn').forEach(b => {
            b.classList.remove('btn-teal-active');
            b.classList.add('btn-outline-secondary');
        });
    } else if (type === 'treatment') {
        activeTreatment = value;
        document.querySelectorAll('.treatment-filter-btn').forEach(b => {
            b.classList.remove('btn-teal-active');
            b.classList.add('btn-outline-secondary');
        });
    }
    
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-teal-active');

    var items = document.querySelectorAll('.product-item-card');
    var visibleCount = 0;

    items.forEach(function(item) {
        var cat = item.dataset.category || '';
        var treat = item.dataset.treatment || '';
        
        var matchCat = (activeCategory === 'All' || cat === activeCategory);
        var matchTreat = (activeTreatment === 'All' || treat === activeTreatment);

        if (matchCat && matchTreat) {
            item.style.display = 'block';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });

    var emptyMsg = document.getElementById('noFilteredProductsMessage');
    if (visibleCount === 0) {
        if (!emptyMsg) {
            var grid = document.getElementById('productGrid');
            var msgHtml = `<div id="noFilteredProductsMessage" class="col-12 text-center py-5 bg-light rounded-4 w-100">
                <div class="text-muted mb-3"><i class="bi-search fs-1"></i></div>
                <h5 class="fw-bold text-dark">Không tìm thấy sản phẩm phù hợp</h5>
                <p class="text-muted small">Vui lòng thử chọn bộ lọc khác.</p>
            </div>`;
            grid.insertAdjacentHTML('beforeend', msgHtml);
        } else {
            emptyMsg.style.display = 'block';
        }
    } else {
        if (emptyMsg) emptyMsg.style.display = 'none';
    }
}

// Countdown Timer for Daily Deals
function startDailyDealsTimer() {
    const now = new Date();
    const endOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
    
    function updateTimer() {
        const currentTime = new Date();
        const difference = endOfDay - currentTime;
        
        if (difference <= 0) {
            const elH = document.getElementById("countdown-hours");
            const elM = document.getElementById("countdown-minutes");
            const elS = document.getElementById("countdown-seconds");
            if (elH) elH.innerText = "00";
            if (elM) elM.innerText = "00";
            if (elS) elS.innerText = "00";
            return;
        }
        
        const hours = Math.floor((difference / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((difference / 1000 / 60) % 60);
        const seconds = Math.floor((difference / 1000) % 60);
        
        const elH = document.getElementById("countdown-hours");
        const elM = document.getElementById("countdown-minutes");
        const elS = document.getElementById("countdown-seconds");
        if (elH) elH.innerText = hours.toString().padStart(2, '0');
        if (elM) elM.innerText = minutes.toString().padStart(2, '0');
        if (elS) elS.innerText = seconds.toString().padStart(2, '0');
    }
    
    updateTimer();
    setInterval(updateTimer, 1000);
}

document.addEventListener("DOMContentLoaded", function() {
    startDailyDealsTimer();
});
</script>


