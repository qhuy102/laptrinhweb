                    <i class="bi bi-capsule-pill fs-3"></i>
                </div>
                <h6 class="fw-bold mb-1">Cần mua thuốc</h6>
                <p class="text-muted mb-0" style="font-size: 0.75rem;">Mua thuốc nhanh trực tuyến</p>
            </div>
