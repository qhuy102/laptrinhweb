    </div>
    <div class="col-6 col-md-3">
        <a href="/Home/PrescriptionUpload?mode=consult" class="text-decoration-none text-dark">
            <div class="card border-0 shadow-sm h-100 quick-feature-card text-center p-3 bg-white" style="border-radius: 16px; transition: all 0.3s ease;">
