@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Hero banner with search -->
<section class="site-hero py-5">
    <div class="container d-flex align-items-center justify-content-between">
        <div class="hero-left">
            <h1 class="hero-title">Gia đình khỏe mạnh cùng Nhà Thuốc 4 thằng trai</h1>
            <p class="hero-sub">Cung cấp thuốc chính hãng, dược phẩm và tư vấn tận tâm.</p>
        </div>

        <div class="hero-search">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-0" placeholder="Tìm kiếm thuốc, bệnh, thành phần...">
                <button class="btn btn-primary rounded-end px-4">Tìm kiếm</button>
            </div>
        </div>
    </div>
</section>

<!-- Promo card -->
<section class="container my-5">
    <div class="promo-card rounded-3 shadow p-4">
        <div class="row align-items-center">
            <div class="col-md-6 text-white">
                <div class="promo-pill mb-3"></div>
                <h2 class="promo-title">Chăm Sóc Sức Khỏe<br/>Gia Đình Bạn</h2>
                <p class="promo-desc">Cung cấp thuốc chính hãng, dược mỹ phẩm cao cấp và thiết bị y tế với đội ngũ dược sĩ tư vấn tận tình 24/7.</p>
                <div class="mt-4">
                    <a class="btn btn-light btn-lg me-2">Mua thuốc ngay</a>
                    <a class="btn btn-outline-light btn-lg">Đăng ký Hội viên</a>
                </div>
            </div>
            <div class="col-md-6 d-none d-md-block">
                <!-- decorative area for image/illustration (optional) -->
            </div>
        </div>
    </div>
</section>

<!-- Placeholder for other content -->
<div class="container">
    <p class="text-muted">Nội dung khác của trang sẽ hiển thị ở đây...</p>
</div>
