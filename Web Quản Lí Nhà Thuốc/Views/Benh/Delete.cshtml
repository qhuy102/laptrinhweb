@model Web_Quản_Lí_Nhà_Thuốc.Models.Benh

@{
    ViewData["Title"] = "Xóa bệnh lý";
}

<div class="container mt-4 mb-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm bg-white overflow-hidden" style="border-radius: 16px;">
        <div class="p-4 bg-danger text-white text-center">
            <i class="bi bi-exclamation-triangle fs-1 d-block mb-2 animate-bounce"></i>
            <h4 class="fw-bold mb-1">Xác nhận xóa bệnh lý</h4>
            <p class="mb-0 text-white-50 small">Hành động này không thể hoàn tác. Dữ liệu tra cứu của người dùng sẽ bị ảnh hưởng.</p>
        </div>
        
        <div class="p-4">
            <h5 class="fw-bold text-dark mb-3 text-center">Bạn có chắc chắn muốn xóa bệnh lý này?</h5>
            
            <div class="p-3 bg-light rounded-3 mb-4">
                <table class="table table-borderless table-sm mb-0 align-middle">
                    <tbody>
                        <tr>
                            <td class="text-muted small py-2" style="width: 30%;">Tên bệnh:</td>
                            <td class="fw-bold text-dark py-2">@Model.TenBenh</td>
                        </tr>
                        <tr>
                            <td class="text-muted small py-2">Nhóm bệnh:</td>
                            <td class="py-2">
                                <span class="badge bg-secondary rounded-pill px-2.5 py-1 text-uppercase fw-semibold" style="font-size: 0.65rem;">@Model.NhomBenh</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted small py-2">Mã bệnh:</td>
                            <td class="font-monospace text-muted small py-2">@Model.MaBenh</td>
                        </tr>
                        <tr>
                            <td class="text-muted small py-2">Mô tả ngắn:</td>
                            <td class="text-muted small py-2 text-truncate-2" style="max-width: 350px;">@Model.MoTaTrieuChung</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2 justify-content-center">
                    <input type="submit" value="Xác nhận xóa bỏ" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold" />
                    <a asp-action="Index" class="btn btn-secondary px-4 py-2 rounded-pill fw-semibold">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
