@model List<Web_Quản_Lí_Nhà_Thuốc.Models.AuditLog>
@{
    ViewData["Title"] = "Nhật Ký Kiểm Toán & Phát Hiện Gian Lận";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Kiểm toán & Phát hiện Gian lận</h1>
        <p class="text-muted mb-0">Theo dõi toàn bộ lịch sử chỉnh sửa tồn kho, tạo tài khoản và các hành vi nghi vấn của hệ thống.</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.location.reload();" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1"></i> Làm mới</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Quick Statistics cards -->
    <div class="col-md-6 col-lg-3">
        <div class="dashboard-card border-start border-4 border-danger">
            <div class="card-icon icon-red bg-danger bg-opacity-10 text-danger">
                <i class="bi bi-shield-slash"></i>
            </div>
            <div class="card-title mt-2">Cảnh báo nghi vấn</div>
            <div class="card-value text-danger">@Model.Count(l => l.IsSuspicious)</div>
            <div class="card-trend text-muted small mt-1">Cần được kiểm tra ngay</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="dashboard-card border-start border-4 border-primary">
            <div class="card-icon icon-blue bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-list-task"></i>
            </div>
            <div class="card-title mt-2">Tổng số bản ghi</div>
            <div class="card-value text-primary">@Model.Count</div>
            <div class="card-trend text-muted small mt-1">Lịch sử 100 giao dịch gần nhất</div>
        </div>
    </div>
</div>

<div class="custom-table-container">
    <div class="custom-table-header d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Lịch Sử Hoạt Động Chi Tiết</h5>
        <div>
            <select id="logFilter" class="form-select form-select-sm" onchange="filterLogs()">
                <option value="all">Tất cả nhật ký</option>
                <option value="suspicious">Chỉ cảnh báo nghi vấn</option>
            </select>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Thời Gian</th>
                    <th>Người Thực Hiện</th>
                    <th>Hành Động</th>
                    <th>Chi Tiết Mô Tả</th>
                    <th>Địa Chỉ IP</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr class="log-row @(log.IsSuspicious ? "table-danger suspicious-log" : "")">
                        <td class="text-nowrap small text-muted">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            <div class="fw-semibold">@log.UserEmail</div>
                            <span class="small text-muted">ID: @log.UserId</span>
                        </td>
                        <td>
                            <span class="badge @(log.Action switch {
                                "SELL" => "bg-success bg-opacity-10 text-success border border-success border-opacity-20",
                                "CREATE_USER" => "bg-info bg-opacity-10 text-info border border-info border-opacity-20",
                                "MANUAL_ADJUST" => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20",
                                _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-20"
                            }) px-2.5 py-1.5" style="border-radius: 6px;">@log.Action</span>
                        </td>
                        <td>
                            <div class="text-dark fw-semibold" style="max-width: 400px; white-space: normal;">@log.MoTa</div>
                        </td>
                        <td class="font-monospace small">@log.IpAddress</td>
                        <td>
                            @if (log.IsSuspicious)
                            {
                                <span class="badge bg-danger px-2.5 py-1.5 rounded-pill"><i class="bi bi-exclamation-triangle-fill me-1"></i> Nghi Vấn Gian Lận</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary px-2.5 py-1.5 rounded-pill border"><i class="bi bi-check-circle-fill me-1"></i> Bình Thường</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterLogs() {
            var val = document.getElementById("logFilter").value;
            var rows = document.querySelectorAll(".log-row");
            rows.forEach(function(row) {
                if (val === "all") {
                    row.style.display = "";
                } else if (val === "suspicious") {
                    if (row.classList.contains("suspicious-log")) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                }
            });
        }
    </script>
}
