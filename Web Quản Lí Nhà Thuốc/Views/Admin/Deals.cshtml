@model IEnumerable<Web_Quản_Lí_Nhà_Thuốc.Models.Thuoc>

@{
    ViewData["Title"] = "Quản lý ưu đãi thuốc";
    var totalMeds = Model.Count();
    var dealMeds = Model.Count(m => m.IsDeal);
    var maxDiscount = Model.Any(m => m.IsDeal) ? Model.Where(m => m.IsDeal).Max(m => m.DiscountPercent) : 0;
}

<style>
    :root {
        --teal-primary: #0d9488;
        --teal-hover: #0f766e;
        --teal-light: #f0fdfa;
        --rose-primary: #f43f5e;
        --rose-light: #ffe4e6;
    }

    .med-dashboard {
        font-family: 'Inter', sans-serif;
    }

    .med-stat-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        overflow: hidden;
        position: relative;
    }

    .med-stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.08);
    }

    .med-stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
    }

    .med-stat-card.stat-total::before { background-color: #6366f1; }
    .med-stat-card.stat-deals::before { background-color: var(--teal-primary); }
    .med-stat-card.stat-max::before { background-color: var(--rose-primary); }

    .icon-shape {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .icon-indigo { background-color: #e0e7ff; color: #6366f1; }
    .icon-teal { background-color: #ccfbf1; color: var(--teal-primary); }
    .icon-rose { background-color: var(--rose-light); color: var(--rose-primary); }

    .med-search-bar {
        border-radius: 12px;
        padding-left: 45px;
        height: 46px;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

    .med-search-bar:focus {
        border-color: var(--teal-primary);
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
    }

    .med-search-wrapper i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }

    .med-select-filter {
        border-radius: 12px;
        height: 46px;
        border: 1px solid #e2e8f0;
    }

    .med-select-filter:focus {
        border-color: var(--teal-primary);
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
    }

    .med-table-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        background: #ffffff;
        overflow: hidden;
    }

    .med-table {
        margin: 0;
    }

    .med-table th {
        background-color: #f8fafc;
        border-bottom: 2px solid #f1f5f9;
        color: #475569;
        font-weight: 600;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 1.1rem 1.25rem;
    }

    .med-table td {
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        font-size: 0.9rem;
    }

    .med-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .med-table tbody tr:hover {
        background-color: #fafbfd;
    }

    .med-thumbnail {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background-color: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--teal-primary);
        font-size: 1.2rem;
        border: 1px solid #e2e8f0;
        object-fit: contain;
    }

    .btn-med-primary {
        background-color: var(--teal-primary);
        color: #ffffff;
        border: none;
        padding: 0.6rem 1.25rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.2s ease;
        box-shadow: 0 4px 10px rgba(13, 148, 136, 0.15);
    }

    .btn-med-primary:hover {
        background-color: var(--teal-hover);
        color: #ffffff;
        box-shadow: 0 6px 14px rgba(13, 148, 136, 0.25);
        transform: translateY(-1px);
    }

    .tab-filter-btn {
        border: none;
        background: transparent;
        padding: 0.6rem 1.2rem;
        font-weight: 500;
        color: #64748b;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .tab-filter-btn:hover {
        background-color: #f1f5f9;
        color: #334155;
    }

    .tab-filter-btn.active {
        background-color: var(--teal-light);
        color: var(--teal-primary);
    }
</style>

<div class="container-fluid py-4 med-dashboard">
    <!-- Breadcrumb and header -->
    <div class="row align-items-center mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-teal text-white py-1.5 px-2.5 rounded-pill" style="background-color: var(--teal-primary) !important; font-size: 0.75rem;">ADMIN PANEL</span>
                <span class="text-muted"><i class="bi bi-chevron-right fs-7"></i></span>
                <span class="text-muted small">Quản lý ưu đãi</span>
            </div>
            <h2 class="fw-bold mb-0 text-dark">Quản lý ưu đãi sản phẩm</h2>
            <p class="text-muted small mb-0">Cấu hình các sản phẩm khuyến mãi, thiết lập phần trăm giảm giá và đồng bộ hóa giá bán trên toàn bộ cửa hàng.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stats summary grid -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-12">
            <div class="card med-stat-card stat-total">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-medium small d-block mb-1">Tổng số thuốc</span>
                        <h3 class="fw-bold mb-0 text-dark">@totalMeds</h3>
                    </div>
                    <div class="icon-shape icon-indigo">
                        <i class="bi bi-capsule"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card med-stat-card stat-deals">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-medium small d-block mb-1">Thuốc đang ưu đãi</span>
                        <h3 class="fw-bold mb-0 text-dark">@dealMeds</h3>
                    </div>
                    <div class="icon-shape icon-teal">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card med-stat-card stat-max">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-medium small d-block mb-1">Mức giảm sâu nhất</span>
                        <h3 class="fw-bold mb-0 text-dark">@maxDiscount%</h3>
                    </div>
                    <div class="icon-shape icon-rose">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Table -->
    <div class="card med-table-card mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-3">
            <div class="row align-items-center g-3">
                <!-- Tab filters -->
                <div class="col-lg-6 col-12 d-flex flex-wrap gap-1">
                    <button class="tab-filter-btn active" id="tab-all" onclick="filterByTab('all')">Tất cả sản phẩm</button>
                    <button class="tab-filter-btn" id="tab-deals" onclick="filterByTab('deals')">Sản phẩm ưu đãi</button>
                    <button class="tab-filter-btn" id="tab-normal" onclick="filterByTab('normal')">Sản phẩm thường</button>
                </div>
                <!-- Search and category select -->
                <div class="col-lg-6 col-12">
                    <div class="row g-2">
                        <div class="col-sm-7 col-12 med-search-wrapper position-relative">
                            <i class="bi bi-search"></i>
                            <input type="text" id="medSearch" class="form-control med-search-bar" placeholder="Tìm tên thuốc, hoạt chất..." onkeyup="performSearchFilter()">
                        </div>
                        <div class="col-sm-5 col-12">
                            <select id="medCategoryFilter" class="form-select med-select-filter" onchange="performSearchFilter()">
                                <option value="">Tất cả danh mục</option>
                                @foreach (var cat in Model.Select(m => m.LoaiThuoc?.TenLoai).Where(t => t != null).Distinct())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table med-table" id="dealsTable">
                <thead>
                    <tr>
                        <th style="width: 50px;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Phân loại</th>
                        <th class="text-end" style="width: 120px;">Đơn giá gốc</th>
                        <th class="text-center" style="width: 140px;">Loại sản phẩm</th>
                        <th class="text-end" style="width: 120px;">Giá sau giảm</th>
                        <th class="text-center" style="width: 320px;">Thiết lập ưu đãi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var lowerName = item.TenThuoc.ToLower();
                        string fallbackImgUrl = "https://via.placeholder.com/100/e2e8f0/0d9488?text=" + Uri.EscapeDataString(item.TenThuoc.Substring(0, Math.Min(item.TenThuoc.Length, 2)));
                        if (lowerName.Contains("panadol") || lowerName.Contains("paracetamol")) {
                            fallbackImgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Tylenol_Extra_Strength.jpg/120px-Tylenol_Extra_Strength.jpg";
                        } else if (lowerName.Contains("cetaphil")) {
                            fallbackImgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Cetaphil_Daily_Facial_Cleanser.png/120px-Cetaphil_Daily_Facial_Cleanser.png";
                        } else if (lowerName.Contains("amoxicillin")) {
                            fallbackImgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/0/07/Amoxicillin_500_mg_capsule.JPG/120px-Amoxicillin_500_mg_capsule.JPG";
                        } else if (lowerName.Contains("vitamin")) {
                            fallbackImgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Ascorbic_acid_crystals.jpg/120px-Ascorbic_acid_crystals.jpg";
                        }

                        <tr class="medicine-row"
                            data-name="@item.TenThuoc.ToLower()"
                            data-active-ingredient="@(item.HoatChat?.ToLower() ?? "")"
                            data-category="@(item.LoaiThuoc?.TenLoai ?? "")"
                            data-is-deal="@(item.IsDeal ? "true" : "false")">
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? fallbackImgUrl : item.HinhAnh)"
                                     alt="@item.TenThuoc"
                                     class="med-thumbnail"
                                     onerror="this.src='https://via.placeholder.com/60x60?text=Thuoc'" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.TenThuoc</div>
                                <div class="text-muted small">HC: @(item.HoatChat ?? "N/A")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border px-2.5 py-1.5 rounded" style="font-size: 0.8rem;">
                                    <i class="bi bi-tag me-1"></i>
                                    @(item.LoaiThuoc?.TenLoai ?? "Chưa phân loại")
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-muted">
                                @item.DonGia.ToString("N0") ₫
                            </td>
                            <td class="text-center">
                                @if (item.IsDeal)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-1.5 fw-bold">
                                        <i class="bi bi-fire me-1"></i> Ưu đãi
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1.5 fw-medium">
                                        Thường
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-bold text-teal" style="color: var(--teal-primary) !important;">
                                @if (item.IsDeal)
                                {
                                    <span class="text-danger">@item.GiaHienTai.ToString("N0") ₫</span>
                                    <div class="text-muted text-decoration-line-through fw-normal small" style="font-size: 0.72rem;">@item.DonGia.ToString("N0") ₫</div>
                                }
                                else
                                {
                                    <span>@item.DonGia.ToString("N0") ₫</span>
                                }
                            </td>
                            <td>
                                <form asp-action="UpdateDeal" method="post" class="d-flex align-items-center justify-content-end gap-2">
                                    <input type="hidden" name="id" value="@item.MaThuoc" />
                                    
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input is-deal-toggle" type="checkbox" name="isDeal" value="true" @(item.IsDeal ? "checked" : "") id="toggle-@item.MaThuoc" />
                                        <label class="form-check-label text-muted small fw-medium" for="toggle-@item.MaThuoc">Áp dụng</label>
                                    </div>

                                    <div class="input-group input-group-sm" style="width: 110px;">
                                        <input type="number" name="discountPercent" value="@item.DiscountPercent" min="0" max="100" class="form-control discount-input" placeholder="0" @(item.IsDeal ? "" : "disabled") />
                                        <span class="input-group-text bg-light border">%</span>
                                    </div>

                                    <button type="submit" class="btn btn-sm btn-med-primary px-3 rounded-3 d-flex align-items-center gap-1">
                                        <i class="bi bi-save-fill" style="font-size: 0.85rem;"></i> Lưu
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="emptyState" class="text-center py-5 bg-white border-top" style="display: none;">
            <div class="mb-3">
                <i class="bi bi-search fs-1 text-muted"></i>
            </div>
            <h5 class="fw-bold text-dark">Không tìm thấy sản phẩm nào</h5>
            <p class="text-muted small">Vui lòng thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let activeTab = 'all';

        // Toggle percentage input state based on apply switch
        document.querySelectorAll('.is-deal-toggle').forEach(toggle => {
            toggle.addEventListener('change', function() {
                const discountInput = this.closest('form').querySelector('.discount-input');
                if (discountInput) {
                    discountInput.disabled = !this.checked;
                    if (!this.checked) {
                        discountInput.value = 0;
                    } else if (discountInput.value == 0) {
                        discountInput.value = 10; // default initial discount
                    }
                }
            });
        });

        function filterByTab(tab) {
            activeTab = tab;
            document.querySelectorAll('.tab-filter-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            performSearchFilter();
        }

        function performSearchFilter() {
            const query = document.getElementById('medSearch').value.toLowerCase().trim();
            const category = document.getElementById('medCategoryFilter').value;
            const rows = document.querySelectorAll('.medicine-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name');
                const ingredient = row.getAttribute('data-active-ingredient');
                const cat = row.getAttribute('data-category');
                const isDeal = row.getAttribute('data-is-deal') === 'true';

                // Search query match
                const matchesQuery = name.includes(query) || ingredient.includes(query);

                // Category match
                const matchesCategory = category === '' || cat === category;

                // Tab match
                let matchesTab = true;
                if (activeTab === 'deals') {
                    matchesTab = isDeal;
                } else if (activeTab === 'normal') {
                    matchesTab = !isDeal;
                }

                if (matchesQuery && matchesCategory && matchesTab) {
                    row.style.display = 'table-row';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyState = document.getElementById('emptyState');
            if (visibleCount === 0) {
                emptyState.style.display = 'block';
            } else {
                emptyState.style.display = 'none';
            }
        }
    </script>
}
