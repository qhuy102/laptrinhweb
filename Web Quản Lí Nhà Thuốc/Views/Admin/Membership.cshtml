@model IEnumerable<Web_Quản_Lí_Nhà_Thuốc.Controllers.UserViewModel>
@{
    ViewData["Title"] = "Quản lý Hội viên VIP";
    
    // Calculate stats
    var totalMembers = Model.Count();
    var silverMembers = Model.Count(m => m.DiemTichLuy >= 500 && m.DiemTichLuy < 1000);
    var goldMembers = Model.Count(m => m.DiemTichLuy >= 1000 && m.DiemTichLuy < 2000);
    var diamondMembers = Model.Count(m => m.DiemTichLuy >= 2000);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-gem text-warning me-2"></i>Quản lý Hội viên VIP</h1>
        <p class="text-muted small mb-0">Theo dõi thông tin chi tiết, cấp bậc VIP, tích điểm và điều chỉnh đặc quyền hội viên của khách hàng.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- VIP Tiers Quick Stats -->
<div class="row g-3 mb-4">
    <!-- Total members -->
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium small d-block mb-1">Tổng số Hội viên</span>
                    <h3 class="fw-bold mb-0 text-dark">@totalMembers</h3>
                </div>
                <div class="icon-shape bg-teal bg-opacity-10 text-teal rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: #0d9488; background-color: rgba(13, 148, 136, 0.1);">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Silver members -->
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium small d-block mb-1">Hội viên Bạc (5%)</span>
                    <h3 class="fw-bold mb-0 text-secondary">@silverMembers</h3>
                </div>
                <div class="icon-shape bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: #64748b; background-color: rgba(100, 116, 139, 0.1);">
                    <i class="bi bi-award fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Gold VIP -->
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium small d-block mb-1">VIP Vàng (10%)</span>
                    <h3 class="fw-bold mb-0 text-warning">@goldMembers</h3>
                </div>
                <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: #d97706; background-color: rgba(217, 119, 6, 0.1);">
                    <i class="bi bi-award-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Diamond VIP -->
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium small d-block mb-1">VIP Kim Cương (15%)</span>
                    <h3 class="fw-bold mb-0 text-indigo" style="color: #4f46e5;">@diamondMembers</h3>
                </div>
                <div class="icon-shape bg-indigo bg-opacity-10 text-indigo rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: #4f46e5; background-color: rgba(79, 70, 229, 0.1);">
                    <i class="bi bi-gem fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search and Table -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; background: white;">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-3">
        <div class="row align-items-center g-3">
            <div class="col-md-6 col-12">
                <h5 class="fw-bold mb-0 text-dark">Danh Sách Thành Viên & Cấp Bậc VIP</h5>
            </div>
            <div class="col-md-6 col-12">
                <div class="input-group rounded-pill overflow-hidden border">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="memberSearch" class="form-control border-0 px-2" placeholder="Tìm kiếm tên hội viên, email..." onkeyup="searchMemberTable()">
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive px-4 pb-4">
        <table class="table table-hover align-middle" id="memberTable">
            <thead>
                <tr class="text-muted small" style="border-bottom: 2px solid #f1f5f9;">
                    <th class="pb-3" style="font-weight: 600;">Họ và Tên</th>
                    <th class="pb-3" style="font-weight: 600;">Email</th>
                    <th class="pb-3" style="font-weight: 600;">Số điện thoại</th>
                    <th class="pb-3" style="font-weight: 600; text-align: center;">Điểm Tích Lũy</th>
                    <th class="pb-3" style="font-weight: 600; text-align: center;">Hạng Hội Viên</th>
                    <th class="pb-3" style="font-weight: 600;">Địa chỉ</th>
                    <th class="pb-3 text-end" style="font-weight: 600;">Điều chỉnh nhanh hạng VIP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    string tierName = "Thành viên";
                    string badgeClass = "bg-secondary bg-opacity-10 text-secondary border-secondary";
                    string iconClass = "bi-award";

                    if (user.DiemTichLuy >= 2000)
                    {
                        tierName = "VIP Kim Cương";
                        badgeClass = "bg-indigo-subtle text-indigo border-indigo-subtle";
                        iconClass = "bi-gem text-indigo";
                    }
                    else if (user.DiemTichLuy >= 1000)
                    {
                        tierName = "VIP Vàng";
                        badgeClass = "bg-warning-subtle text-warning border-warning-subtle";
                        iconClass = "bi-award-fill text-warning";
                    }
                    else if (user.DiemTichLuy >= 500)
                    {
                        tierName = "Thành viên Bạc";
                        badgeClass = "bg-silver-subtle text-silver border-silver-subtle";
                        iconClass = "bi-award text-secondary";
                    }

                    <tr style="border-bottom: 1px solid #f8fafc;" class="member-row" data-name="@user.HoTen.ToLower()" data-email="@user.Email.ToLower()">
                        <td class="py-3">
                            <div class="fw-semibold text-dark">@user.HoTen</div>
                        </td>
                        <td class="py-3 text-muted">@user.Email</td>
                        <td class="py-3 text-muted">@user.PhoneNumber</td>
                        <td class="py-3 text-center fw-bold text-dark">
                            @user.DiemTichLuy
                        </td>
                        <td class="py-3 text-center">
                            <span class="badge border rounded-pill px-3 py-1.5 small fw-semibold d-inline-flex align-items-center gap-1.5 @badgeClass">
                                <i class="bi @iconClass"></i>@tierName
                            </span>
                        </td>
                        <td class="py-3 text-muted">@user.DiaChi</td>
                        <td class="py-3 text-end">
                            <div class="d-inline-flex gap-1">
                                <!-- Set Silver (500 pts) -->
                                <form asp-action="UpdateMemberPoints" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="points" value="500" />
                                    <button type="submit" class="btn btn-xs btn-outline-secondary rounded-pill" title="Set hạng Bạc (500 điểm)">Bạc</button>
                                </form>

                                <!-- Set Gold (1000 pts) -->
                                <form asp-action="UpdateMemberPoints" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="points" value="1000" />
                                    <button type="submit" class="btn btn-xs btn-outline-warning rounded-pill" title="Set hạng Vàng (1000 điểm)">Vàng</button>
                                </form>

                                <!-- Set Diamond (2000 pts) -->
                                <form asp-action="UpdateMemberPoints" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="points" value="2000" />
                                    <button type="submit" class="btn btn-xs btn-outline-indigo rounded-pill" title="Set hạng Kim Cương (2000 điểm)">K.Cương</button>
                                </form>

                                <!-- Custom points edit -->
                                <button type="button" class="btn btn-xs btn-outline-teal rounded-pill" onclick="openEditPointsModal('@user.Id', '@user.HoTen', @user.DiemTichLuy)" title="Nhập điểm tùy biến">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal cập nhật điểm tùy biến -->
<div class="modal fade" id="editPointsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="UpdateMemberPoints" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalUserId" name="userId" />

                <div class="modal-header border-0 bg-light p-4">
                    <h5 class="modal-title fw-bold text-dark mb-0">Cập nhật điểm tích lũy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Hội viên</label>
                        <input type="text" id="modalCustomerName" class="form-control bg-light border-0 py-2" readonly style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label for="modalPointsInput" class="form-label small fw-semibold text-secondary">Điểm tích lũy mới <span class="text-danger">*</span></label>
                        <input type="number" id="modalPointsInput" name="points" class="form-control py-2" style="border-radius: 8px;" min="0" max="100000" required />
                        <div class="form-text small text-muted mt-1">
                            Mốc quy đổi: Bạc $\ge$ 500, Vàng $\ge$ 1000, Kim Cương $\ge$ 2000.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-teal-btn rounded-pill px-4 fw-bold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #0d9488;
        --indigo-color: #4f46e5;
    }
    
    .bg-indigo-subtle { background-color: rgba(79, 70, 229, 0.1) !important; }
    .text-indigo { color: var(--indigo-color) !important; }
    .border-indigo-subtle { border-color: rgba(79, 70, 229, 0.2) !important; }
    
    .bg-silver-subtle { background-color: rgba(100, 116, 139, 0.1) !important; }
    .text-silver { color: #475569 !important; }
    .border-silver-subtle { border-color: rgba(100, 116, 139, 0.2) !important; }

    .bg-warning-subtle { background-color: rgba(217, 119, 6, 0.1) !important; }
    .text-warning { color: #d97706 !important; }
    .border-warning-subtle { border-color: rgba(217, 119, 6, 0.2) !important; }

    .btn-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.5;
        border-radius: 0.2rem;
    }

    .btn-outline-indigo {
        border-color: var(--indigo-color) !important;
        color: var(--indigo-color) !important;
    }
    .btn-outline-indigo:hover {
        background-color: var(--indigo-color) !important;
        color: white !important;
    }

    .btn-outline-teal {
        border-color: var(--primary-color) !important;
        color: var(--primary-color) !important;
    }
    .btn-outline-teal:hover {
        background-color: var(--primary-color) !important;
        color: white !important;
    }

    .btn-teal-btn {
        background-color: var(--primary-color) !important;
        color: white !important;
    }
    .btn-teal-btn:hover {
        background-color: #0f766e !important;
        color: white !important;
    }
</style>

@section Scripts {
    <script>
        var editPointsModalInstance = null;

        function searchMemberTable() {
            var input = document.getElementById("memberSearch").value.toLowerCase();
            var rows = document.querySelectorAll(".member-row");

            rows.forEach(function(row) {
                var name = row.getAttribute("data-name") || "";
                var email = row.getAttribute("data-email") || "";
                if (name.indexOf(input) > -1 || email.indexOf(input) > -1) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function openEditPointsModal(userId, customerName, currentPoints) {
            document.getElementById("modalUserId").value = userId;
            document.getElementById("modalCustomerName").value = customerName;
            document.getElementById("modalPointsInput").value = currentPoints;

            editPointsModalInstance = new bootstrap.Modal(document.getElementById("editPointsModal"));
            editPointsModalInstance.show();
        }
    </script>
}
