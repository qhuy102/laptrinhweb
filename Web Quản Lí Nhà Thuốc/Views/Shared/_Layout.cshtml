@using Microsoft.AspNetCore.Identity
@using Web_Quản_Lí_Nhà_Thuốc.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lí Nhà Thuốc</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        <!-- Sidebar for Admin -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-brand">
                    <i class="bi bi-capsule"></i>
                    PharmaAdmin
                </a>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/" class="sidebar-link active">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Tổng quan</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-box-seam"></i>
                        <span>Kho thuốc</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-cart3"></i>
                        <span>Đơn hàng</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Users" class="sidebar-link">
                        <i class="bi bi-people"></i>
                        <span>Quản lý người dùng</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-graph-up"></i>
                        <span>Báo cáo</span>
                    </a>
                </li>
                <li style="margin-top: auto; padding-top: 2rem;">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-gear"></i>
                        <span>Cài đặt</span>
                    </a>
                </li>
            </ul>
        </aside>
    }

    <!-- Main Content -->
    <main class="main-content" style="@(SignInManager.IsSignedIn(User) && User.IsInRole("Admin") ? "" : "margin-left: 0;")">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Tìm kiếm thuốc, đơn hàng...">
            </div>
            
            <div class="topbar-right">
                @if (SignInManager.IsSignedIn(User))
                {
                    var user = await UserManager.GetUserAsync(User);
                    <div class="notification-btn">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge">3</span>
                    </div>
                    
                    <div class="user-profile dropdown">
                        <div class="user-avatar" data-bs-toggle="dropdown">
                            @(user?.HoTen?.Substring(0, 2).ToUpper() ?? "US")
                        </div>
                        <div class="user-info d-none d-md-block" data-bs-toggle="dropdown">
                            <div class="fw-semibold text-dark" style="font-size: 0.875rem;">@user?.HoTen</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@(User.IsInRole("Admin") ? "Quản trị viên" : "Thành viên")</div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 12px;">
                            <li><a class="dropdown-item py-2" href="/Identity/Account/Manage"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Identity/Account/Login" class="btn btn-outline-primary btn-sm rounded-pill px-3">Đăng nhập</a>
                    <a href="/Identity/Account/Register" class="btn btn-primary btn-sm rounded-pill px-3">Đăng ký</a>
                }
            </div>
        </header>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </main>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
