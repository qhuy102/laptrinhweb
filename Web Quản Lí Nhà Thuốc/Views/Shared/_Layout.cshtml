    <!-- Chatbot JS Integration Logic -->
    <script>
        var chatConnection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        chatConnection.on("ReceiveUserMessage", function (message) {
            appendUserBubble(message);
        });

        chatConnection.on("ReceiveBotMessage", function (message) {
            appendBotBubble(message);
        });

        chatConnection.on("ReceiveTypingStatus", function (isTyping) {
            toggleTypingIndicator(isTyping);
        });

        chatConnection.start().then(function() {
            console.log("Connected to ChatHub successfully!");
        }).catch(function (err) {
            console.error("SignalR ChatHub Connection Error: ", err);
        });

        function toggleChatbot() {
            var botWindow = document.getElementById('pharmacistChatbot');
            botWindow.classList.toggle('open');
            if(botWindow.classList.contains('open')) {
                document.querySelector('.chatbot-float-btn').classList.remove('pulse-active');
                scrollToChatBottom();
                document.getElementById('chatbotInputField').focus();
            } else {
                document.querySelector('.chatbot-float-btn').classList.add('pulse-active');
            }
        }

        function handleInputKeydown(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendUserMessage();
            }
        }

        function sendUserMessage() {
            var inputField = document.getElementById('chatbotInputField');
            var msg = inputField.value.trim();
            if (!msg) return;

            inputField.value = "";
            chatConnection.invoke("AskAI", msg).catch(function (err) {
                console.error(err.toString());
            });
        }

        function sendQuickMessage(text) {
            chatConnection.invoke("AskAI", text).catch(function (err) {
                console.error(err.toString());
            });
        }

        function appendUserBubble(text) {
            var chatList = document.getElementById('chatbotMessagesList');
            var bubbleHtml = `
                <div class="chat-bubble-container user-msg">
                    <div class="chat-bubble-avatar user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="chat-bubble">
                        ${text}
                    </div>
                </div>`;
            chatList.innerHTML += bubbleHtml;
            scrollToChatBottom();
        }

        function appendBotBubble(text) {
            var chatList = document.getElementById('chatbotMessagesList');
            var bubbleHtml = `
                <div class="chat-bubble-container bot-msg">
                    <div class="chat-bubble-avatar bot-avatar">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="chat-bubble">
                        ${text}
                    </div>
                </div>`;
            chatList.innerHTML += bubbleHtml;
            scrollToChatBottom();
        }

        function toggleTypingIndicator(show) {
            var chatList = document.getElementById('chatbotMessagesList');
            var existingIndicator = document.getElementById('botTypingIndicator');
            
            if (show) {
                if (!existingIndicator) {
                    var indicatorHtml = `
                        <div class="typing-indicator-container" id="botTypingIndicator">
                            <div class="chat-bubble-avatar bot-avatar">
                                <i class="bi bi-robot"></i>
                            </div>
                            <div class="typing-indicator">
                                <div class="typing-dot"></div>
                                <div class="typing-dot"></div>
                                <div class="typing-dot"></div>
                            </div>
                        </div>`;
                    chatList.innerHTML += indicatorHtml;
                }
            } else {
                if (existingIndicator) {
                    existingIndicator.remove();
                }
            }
            scrollToChatBottom();
        }

        function scrollToChatBottom() {
            var msgsDiv = document.getElementById('chatbotMessagesList');
            msgsDiv.scrollTop = msgsDiv.scrollHeight;
        }

        // Add drug to cart via AJAX
        function addDrugToCart(id, name) {
            var formData = new FormData();
            formData.append('id', id);

            fetch('/Cart/AddToCartAjax', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Update global badges
                    if (window.updateTopbarCounts) {
                        window.updateTopbarCounts();
                    } else {
                        var badge = document.getElementById("cartBadge");
                        if (badge) {
                            badge.innerText = data.cartCount;
                            badge.style.display = "inline-block";
                        }
                    }
                    
                    // Display response in chat
                    appendBotBubble(`✅ Đã thêm <strong>${name}</strong> vào giỏ hàng thành công!`);
                } else {
                    appendBotBubble(`❌ Thêm giỏ hàng thất bại: ${data.message}`);
                }
            })
            .catch(err => {
                console.error(err);
                appendBotBubble(`❌ Lỗi kết nối khi thêm vào giỏ hàng.`);
            });
        }

        // Add all OCR matched drugs to cart
        async function addAllDrugsToCart(ids) {
            appendBotBubble("🛒 Đang thêm tất cả thuốc trong đơn vào giỏ hàng của bạn...");
            toggleTypingIndicator(true);

            let addedCount = 0;
            for (let id of ids) {
                try {
                    var formData = new FormData();
                    formData.append('id', id);
                    let res = await fetch('/Cart/AddToCartAjax', {
                        method: 'POST',
                        body: formData
                    });
                    let data = await res.json();
                    if (data.success) {
                        addedCount++;
                    }
                } catch (e) {
                    console.error(e);
                }
            }

            toggleTypingIndicator(false);
            if (window.updateTopbarCounts) {
                window.updateTopbarCounts();
            }
            appendBotBubble(`✅ Thành công! Đã thêm <strong>${addedCount}</strong> thuốc từ đơn vào giỏ hàng của bạn.`);
        }

        // Open detailed popup from chatbot list
        function showDetailPopup(id, name, img, price, desc, usage, dose) {
            document.getElementById('detailModalTitle').innerText = name;
            document.getElementById('detailModalName').innerText = name;
            document.getElementById('detailModalPrice').innerText = price;
            document.getElementById('detailModalImg').src = img;
            document.getElementById('detailModalDesc').innerText = desc;
            document.getElementById('detailModalUsage').innerText = usage;
            document.getElementById('detailModalDose').innerText = dose;
            
            document.getElementById('detailModalAddBtn').onclick = function() {
                addDrugToCart(id, name);
                var modalEl = document.getElementById('drugDetailModal');
                var modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();
            };

            var detailModal = new bootstrap.Modal(document.getElementById('drugDetailModal'));
            detailModal.show();
        }

        // Handle image upload and OCR parsing client-side via Tesseract.js
        function handlePrescriptionUpload(input) {
            if (!input.files || !input.files[0]) return;
            var file = input.files[0];
            
            // Log file info
            appendUserBubble(`📷 <em>Đã tải lên ảnh đơn thuốc: ${file.name}</em>`);
            toggleTypingIndicator(true);
            
            // Render loading text details
            var chatList = document.getElementById('chatbotMessagesList');
            var logBubble = document.createElement('div');
            logBubble.className = "chat-bubble-container bot-msg";
            logBubble.innerHTML = `
                <div class="chat-bubble-avatar bot-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="chat-bubble text-muted small" id="ocrLogBubble">
                    <i class="bi bi-arrow-repeat spin me-2"></i> Khởi tạo công cụ quét đơn thuốc AI OCR... (0%)
                </div>`;
            chatList.appendChild(logBubble);
            scrollToChatBottom();

            // Run Tesseract.js OCR
            Tesseract.recognize(
                file,
                'eng+vie',
                {
                    logger: m => {
                        if (m.status === 'recognizing') {
                            var percent = Math.round(m.progress * 100);
                            var logBubbleEl = document.getElementById('ocrLogBubble');
                            if (logBubbleEl) {
                                logBubbleEl.innerHTML = `<i class="bi bi-hourglass-split me-2 text-primary"></i> Đang đọc chữ trên đơn thuốc... (${percent}%)`;
                            }
                        }
                    }
                }
            ).then(({ data: { text } }) => {
                var logBubbleEl = document.getElementById('ocrLogBubble');
                if (logBubbleEl) logBubbleEl.remove(); // Clean up progress bubble
                
                console.log("OCR Result Text: ", text);
                
                // Submit text to hub to match database medicines
                chatConnection.invoke("ProcessPrescriptionText", text).catch(function (err) {
                    console.error("SignalR ProcessPrescriptionText invoke error: ", err);
                    toggleTypingIndicator(false);
                    appendBotBubble("❌ Lỗi xử lý dữ liệu sau OCR trên máy chủ.");
                });
            }).catch(err => {
                console.error("Tesseract OCR Exception: ", err);
                var logBubbleEl = document.getElementById('ocrLogBubble');
                if (logBubbleEl) logBubbleEl.remove();
                toggleTypingIndicator(false);
                appendBotBubble("❌ Lỗi quét văn bản đơn thuốc. Hãy thử chụp ảnh rõ nét hơn dưới ánh sáng tốt.");
            });

            // Clear input so same file can be re-uploaded
            input.value = "";
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

