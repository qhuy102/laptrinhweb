<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lí Nhà Thuốc</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="/" class="sidebar-brand">
                <i class="bi bi-capsule"></i>
                PharmaAdmin
            </a>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/" class="sidebar-link active">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>
            </li>
            <li>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-box-seam"></i>
                    <span>Kho thuốc</span>
                </a>
            </li>
            <li>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-cart3"></i>
                    <span>Đơn hàng</span>
                </a>
            </li>
            <li>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-people"></i>
                    <span>Khách hàng</span>
                </a>
            </li>
            <li>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-graph-up"></i>
                    <span>Báo cáo</span>
                </a>
            </li>
            <li style="margin-top: auto; padding-top: 2rem;">
                <a href="#" class="sidebar-link">
                    <i class="bi bi-gear"></i>
                    <span>Cài đặt</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Tìm kiếm thuốc, đơn hàng...">
            </div>
            
            <div class="topbar-right">
                <div class="notification-btn">
                    <i class="bi bi-bell"></i>
                    <span class="notification-badge">3</span>
                </div>
                
                <div class="user-profile">
                    <div class="user-avatar">AD</div>
                    <div class="user-info d-none d-md-block">
                        <div class="fw-semibold text-dark" style="font-size: 0.875rem;">Admin</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Quản trị viên</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </main>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
