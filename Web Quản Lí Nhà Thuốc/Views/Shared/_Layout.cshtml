@using Microsoft.AspNetCore.Identity
@using Web_Quản_Lí_Nhà_Thuốc.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lí Nhà Thuốc</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")))
    {
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-brand">
                    <i class="bi bi-capsule"></i>
                    PharmaHub
                </a>
            </div>
            <ul class="sidebar-menu">
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a href="/" class="sidebar-link">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Tổng quan Admin</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/Users" class="sidebar-link">
                            <i class="bi bi-people"></i>
                            <span>Quản lý người dùng</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/CreatePharmacist" class="sidebar-link">
                            <i class="bi bi-person-plus"></i>
                            <span>Tạo tài khoản Dược sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/AuditLogs" class="sidebar-link">
                            <i class="bi bi-shield-check"></i>
                            <span>Kiểm toán &amp; Logs</span>
                        </a>
                    </li>
                    <!-- Admin cũng có thể truy cập trang Dược sĩ -->
                    <li class="sidebar-divider"><span>Chức năng Dược sĩ</span></li>
                    <li>
                        <a href="/Pharmacist/Dashboard" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Dược Sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Sell" class="sidebar-link">
                            <i class="bi bi-cart-plus"></i>
                            <span>Bán thuốc (POS)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Prescriptions" class="sidebar-link">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Quản lý Đơn thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Consult" class="sidebar-link">
                            <i class="bi bi-search"></i>
                            <span>Tư vấn thuốc</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Pharmacist"))
                {
                    <li>
                        <a href="/Pharmacist/Dashboard" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Dược Sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Sell" class="sidebar-link">
                            <i class="bi bi-cart-plus"></i>
                            <span>Bán thuốc (POS)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Prescriptions" class="sidebar-link">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Quản lý Đơn thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Consult" class="sidebar-link">
                            <i class="bi bi-search"></i>
                            <span>Tư vấn thuốc</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>
    }

    <!-- Main Content -->
    <main class="main-content" style="@(SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")) ? "" : "margin-left: 0;")">
        <!-- Unified Top Toolbar -->
        <header class="topbar unified-toolbar">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <a class="navbar-brand d-flex align-items-center text-white fw-bold" href="/">
                        <i class="bi bi-capsule me-2"></i>
                        <span class="brand-main">NHÀ THUỐC</span>
                        <span class="brand-accent ms-2 text-success">4 thằng trai</span>
                    </a>

                    <ul class="nav toolbar-links d-none d-lg-flex">
                        <li class="nav-item"><a class="nav-link text-white" href="#">Thuốc</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#">Tra cứu bệnh</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#">Thực phẩm bảo vệ sức khỏe</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#">Mẹ và bé</a></li>
                    </ul>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="notification-btn position-relative me-2">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge">3</span>
                    </div>

                    <a href="/Cart" class="btn btn-link text-white position-relative me-2"><i class="bi bi-cart3"></i><span class="notification-badge">2</span></a>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="user-menu dropdown">
                            <button class="btn user-avatar-btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar me-2"><i class="bi bi-person-circle"></i></div>
                                <span class="user-name d-none d-md-inline">@(currentUser?.HoTen ?? User.Identity?.Name)</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 12px; min-width: 250px;">
                                <li>
                                    <a class="dropdown-item py-2" href="/Identity/Account/Manage">
                                        <i class="bi bi-person me-2"></i>
                                        Hồ sơ cá nhân
                                    </a>
                                </li>

                                @if (!User.IsInRole("Admin") && !User.IsInRole("Pharmacist"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2" href="/User/Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/Order/MyOrders">
                                            <i class="bi bi-bag-check me-2"></i>
                                            Đơn hàng của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/Cart">
                                            <i class="bi bi-cart3 me-2"></i>
                                            Giỏ hàng
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/User/Favorites">
                                            <i class="bi bi-heart me-2"></i>
                                            Sản phẩm yêu thích
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Identity/Account/Login" class="btn btn-outline-light btn-sm rounded-pill px-3">Đăng nhập</a>
                        <a href="/Identity/Account/Register" class="btn btn-primary btn-sm rounded-pill px-3">Đăng ký</a>
                    }
                </div>
            </div>
        </header>

        <!-- Search bar below unified toolbar -->
        <div class="container py-3">
            <div class="input-group shadow-sm rounded-pill mx-auto" style="max-width:920px;">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-0" placeholder="Tìm kiếm thuốc, bệnh, thành phần...">
                <button class="btn btn-primary rounded-end px-4">Tìm kiếm</button>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </main>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
