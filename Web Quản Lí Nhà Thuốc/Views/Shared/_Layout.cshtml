@using Microsoft.AspNetCore.Identity
@using Web_Quản_Lí_Nhà_Thuốc.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lí Nhà Thuốc</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .suggestion-item:hover {
            background-color: #f1f5f9 !important;
        }
        .text-teal {
            color: #0d9488 !important;
        }
    </style>
</head>
<body>
    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")))
    {
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-brand">
                    <i class="bi bi-capsule"></i>
                    PharmaHub
                </a>
            </div>
            <ul class="sidebar-menu">
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a href="/" class="sidebar-link">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Tổng quan Admin</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/Users" class="sidebar-link">
                            <i class="bi bi-people"></i>
                            <span>Quản lý người dùng</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/CreatePharmacist" class="sidebar-link">
                            <i class="bi bi-person-plus"></i>
                            <span>Tạo tài khoản Dược sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/AuditLogs" class="sidebar-link">
                            <i class="bi bi-shield-check"></i>
                            <span>Kiểm toán &amp; Logs</span>
                        </a>
                    </li>
                    <li class="sidebar-divider"><span>Quản lý Kho & Đơn Hàng</span></li>
                    <li>
                        <a href="/Category/Index" class="sidebar-link">
                            <i class="bi bi-tags"></i>
                            <span>Phân loại Thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Medicine/Index" class="sidebar-link">
                            <i class="bi bi-capsule-pill"></i>
                            <span>Quản lý Thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/OrderManagement/Index" class="sidebar-link">
                            <i class="bi bi-box-seam"></i>
                            <span>Quản lý Đơn hàng</span>
                        </a>
                    </li>
                    <!-- Admin cũng có thể truy cập trang Dược sĩ -->
                    <li class="sidebar-divider"><span>Chức năng Dược sĩ</span></li>
                    <li>
                        <a href="/Pharmacist/Dashboard" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Dược Sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Sell" class="sidebar-link">
                            <i class="bi bi-cart-plus"></i>
                            <span>Bán thuốc (POS)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Prescriptions" class="sidebar-link">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Quản lý Đơn thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Consult" class="sidebar-link">
                            <i class="bi bi-search"></i>
                            <span>Tư vấn thuốc</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Pharmacist"))
                {
                    <li>
                        <a href="/Pharmacist/Dashboard" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Dược Sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Sell" class="sidebar-link">
                            <i class="bi bi-cart-plus"></i>
                            <span>Bán thuốc (POS)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Prescriptions" class="sidebar-link">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Quản lý Đơn thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Consult" class="sidebar-link">
                            <i class="bi bi-search"></i>
                            <span>Tư vấn thuốc</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>
    }

    <!-- Main Content -->
    <main class="main-content" style="@(SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")) ? "" : "margin-left: 0;")">
        <!-- Unified Top Toolbar -->
        <header class="topbar unified-toolbar">
            <div class="container d-flex align-items-center">
                <div class="left-group d-flex align-items-center">
                    <a class="navbar-brand d-flex align-items-center text-white fw-bold me-3" href="/">
                        <i class="bi bi-capsule me-2"></i>
                        <span class="brand-main">NHÀ THUỐC</span>
                        <span class="brand-accent ms-2 text-success">4 thằng trai</span>
                    </a>

                    <!-- Category dropdown button -->
                    <div class="dropdown d-none d-lg-block">
                        <button class="btn btn-category d-flex align-items-center" type="button" id="categoryDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill me-2"></i>
                            <span class="fw-semibold">Danh mục</span>
                            <i class="bi bi-caret-down-fill ms-2"></i>
                        </button>
                        <ul class="dropdown-menu p-2 shadow" aria-labelledby="categoryDropdown">
                            <li><a class="dropdown-item" href="/Catalog/Index">Tất cả danh mục</a></li>
                            <li><a class="dropdown-item" href="/Catalog/Index?cat=thuoc">Thuốc</a></li>
                            <li><a class="dropdown-item" href="/Catalog/Index?cat=tracuu">Tra cứu bệnh</a></li>
                            <li><a class="dropdown-item" href="/Catalog/Index?cat=tpcn">Thực phẩm bảo vệ sức khỏe</a></li>
                            <li><a class="dropdown-item" href="/Catalog/Index?cat=me-be">Mẹ và bé</a></li>
                            <li><a class="dropdown-item" href="/Catalog/Index?cat=thietbiyte">Thiết bị y tế</a></li>
                            <li><a class="dropdown-item" href="/Catalog/Index?cat=sanpham-tien-loi">Sản phẩm tiện lợi</a></li>
                        </ul>
                    </div>
                </div>

                <div class="center-nav d-none d-lg-flex justify-content-center flex-grow-1">
                    <ul class="nav toolbar-links">
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=thuoc">Thuốc</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=tracuu">Tra cứu bệnh</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=tpcn">Thực phẩm bảo vệ sức khỏe</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=me-be">Mẹ và bé</a></li>
                    </ul>
                </div>

                <div class="right-group d-flex align-items-center ms-auto gap-2">
                    <div class="notification-btn position-relative me-2" style="cursor: pointer;" onclick="window.location.href='/Order/MyOrders'">
                        <i class="bi bi-bell text-white fs-5"></i>
                        <span id="notificationBadge" class="notification-badge" style="display: none;">0</span>
                    </div>

                    <a href="/Cart" class="btn btn-link text-white position-relative me-2">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span id="cartBadge" class="notification-badge" style="display: none;">0</span>
                    </a>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="user-menu dropdown">
                            <button class="btn user-avatar-btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar me-2"><i class="bi bi-person-circle"></i></div>
                                <span class="user-name d-none d-md-inline">@(currentUser?.HoTen ?? User.Identity?.Name)</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 12px; min-width: 250px;">
                                <li>
                                    <a class="dropdown-item py-2" href="/Identity/Account/Manage">
                                        <i class="bi bi-person me-2"></i>
                                        Hồ sơ cá nhân
                                    </a>
                                </li>

                                @if (!User.IsInRole("Admin") && !User.IsInRole("Pharmacist"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2" href="/User/Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/Order/MyOrders">
                                            <i class="bi bi-bag-check me-2"></i>
                                            Đơn hàng của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/Cart">
                                            <i class="bi bi-cart3 me-2"></i>
                                            Giỏ hàng
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/User/Favorites">
                                            <i class="bi bi-heart me-2"></i>
                                            Sản phẩm yêu thích
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Identity/Account/Login" class="btn btn-outline-light btn-sm rounded-pill px-3">Đăng nhập</a>
                        <a href="/Identity/Account/Register" class="btn btn-primary btn-sm rounded-pill px-3">Đăng ký</a>
                    }
                </div>
            </div>
        </header>

        <!-- Search bar below unified toolbar -->
        <div class="container py-3">
            <div class="input-group shadow-sm rounded-pill mx-auto position-relative" style="max-width:920px; z-index: 1000;">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                <div class="flex-grow-1 position-relative">
                    <input type="text" id="topbarSearchInput" class="form-control border-0 autocomplete-input" placeholder="Tìm kiếm thuốc, bệnh, thành phần..." autocomplete="off">
                    <div id="searchSuggestionsDropdown" class="suggestions-dropdown shadow rounded-3 bg-white position-absolute w-100 mt-2 p-2" style="display: none; z-index: 1050; border: 1px solid #cbd5e1; max-height: 350px; overflow-y: auto;"></div>
                </div>
                <button class="btn btn-primary rounded-end px-4" onclick="triggerSearch()">Tìm kiếm</button>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </main>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Update notification & cart counts dynamically
        function updateTopbarCounts() {
            fetch('/Home/GetCartAndNotificationCounts')
                .then(res => res.json())
                .then(data => {
                    var cartBadge = document.getElementById("cartBadge");
                    var notifBadge = document.getElementById("notificationBadge");

                    if (cartBadge) {
                        if (data.cartCount > 0) {
                            cartBadge.innerText = data.cartCount;
                            cartBadge.style.display = "inline-block";
                        } else {
                            cartBadge.style.display = "none";
                        }
                    }

                    if (notifBadge) {
                        if (data.notificationCount > 0) {
                            notifBadge.innerText = data.notificationCount;
                            notifBadge.style.display = "inline-block";
                        } else {
                            notifBadge.style.display = "none";
                        }
                    }
                })
                .catch(err => console.error("Error updating badges:", err));
        }

        // Initialize autocomplete search suggestions
        document.addEventListener("DOMContentLoaded", function() {
            updateTopbarCounts();

            var searchInput = document.getElementById("topbarSearchInput");
            var dropdown = document.getElementById("searchSuggestionsDropdown");

            if (searchInput && dropdown) {
                searchInput.addEventListener("input", function() {
                    var query = searchInput.value.trim();
                    if (query.length < 2) {
                        dropdown.innerHTML = "";
                        dropdown.style.display = "none";
                        return;
                    }

                    fetch('/Home/GetSearchSuggestions?query=' + encodeURIComponent(query))
                        .then(res => res.json())
                        .then(data => {
                            dropdown.innerHTML = "";
                            if (data.length === 0) {
                                dropdown.innerHTML = `<div class="p-2 text-muted small"><i class="bi bi-info-circle me-1"></i>Không tìm thấy thuốc khớp với từ khóa</div>`;
                                dropdown.style.display = "block";
                                return;
                            }

                            data.forEach(function(item) {
                                var imgUrl = item.hinhAnh || "";
                                if (!imgUrl) {
                                    var lowerName = item.tenThuoc.toLowerCase();
                                    if (lowerName.includes("panadol") || lowerName.includes("paracetamol")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Tylenol_Extra_Strength.jpg/500px-Tylenol_Extra_Strength.jpg";
                                    } else if (lowerName.includes("cetaphil")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Cetaphil_Daily_Facial_Cleanser.png/500px-Cetaphil_Daily_Facial_Cleanser.png";
                                    } else if (lowerName.includes("amoxicillin")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/0/07/Amoxicillin_500_mg_capsule.JPG/500px-Amoxicillin_500_mg_capsule.JPG";
                                    } else if (lowerName.includes("vitamin c")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Ascorbic_acid_crystals.jpg/500px-Ascorbic_acid_crystals.jpg";
                                    } else {
                                        imgUrl = "https://via.placeholder.com/60x60?text=Thuoc";
                                    }
                                }

                                var priceFormatted = item.donGia.toLocaleString('vi-VN') + " đ";
                                var itemHtml = `
                                    <div class="suggestion-item d-flex align-items-center p-2 rounded" style="cursor: pointer; transition: background-color 0.2s;" onclick="selectSuggestion('${item.tenThuoc}')">
                                        <img src="${imgUrl}" alt="${item.tenThuoc}" class="rounded border" style="width: 40px; height: 40px; object-fit: contain; background: white;">
                                        <div class="ms-3 flex-grow-1 text-truncate">
                                            <div class="fw-bold text-dark small mb-0">${item.tenThuoc}</div>
                                            <span class="text-muted" style="font-size: 0.72rem;">${item.loaiThuoc} ${item.hoatChat ? ' • ' + item.hoatChat : ''}</span>
                                        </div>
                                        <div class="text-teal fw-bold small text-nowrap ms-2">${priceFormatted}</div>
                                    </div>
                                `;
                                dropdown.innerHTML += itemHtml;
                            });
                            dropdown.style.display = "block";
                        })
                        .catch(err => console.error("Error fetching suggestions:", err));
                });

                // Hide dropdown on clicking outside
                document.addEventListener("click", function(e) {
                    if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.style.display = "none";
                    }
                });

                // Trigger search on Enter key
                searchInput.addEventListener("keypress", function(e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        triggerSearch();
                    }
                });
            }
        });

        function selectSuggestion(name) {
            var searchInput = document.getElementById("topbarSearchInput");
            if (searchInput) {
                searchInput.value = name;
                document.getElementById("searchSuggestionsDropdown").style.display = "none";
                triggerSearch();
            }
        }

        function triggerSearch() {
            var searchInput = document.getElementById("topbarSearchInput");
            if (searchInput && searchInput.value.trim()) {
                window.location.href = '/Catalog/Index?cat=thuoc&loaiId=&query=' + encodeURIComponent(searchInput.value.trim());
            }
        }

        // Hook updateTopbarCounts to window so other views can refresh counts
        window.updateTopbarCounts = updateTopbarCounts;
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
