    <script>
        // Update notification & cart counts dynamically
        function updateTopbarCounts() {
            fetch('/Home/GetCartAndNotificationCounts')
                .then(res => res.json())
                .then(data => {
                    var cartBadge = document.getElementById("cartBadge");
                    var notifBadge = document.getElementById("notificationBadge");

                    if (cartBadge) {
                        if (data.cartCount > 0) {
                            cartBadge.innerText = data.cartCount;
                            cartBadge.style.display = "inline-block";
                        } else {
                            cartBadge.style.display = "none";
                        }
                    }

                    if (notifBadge) {
                        if (data.notificationCount > 0) {
                            notifBadge.innerText = data.notificationCount;
                            notifBadge.style.display = "inline-block";
                        } else {
                            notifBadge.style.display = "none";
                        }
                    }
                })
                .catch(err => console.error("Error updating badges:", err));
        }

        // Initialize autocomplete search suggestions
        document.addEventListener("DOMContentLoaded", function() {
            updateTopbarCounts();

            var searchInput = document.getElementById("topbarSearchInput");
            var dropdown = document.getElementById("searchSuggestionsDropdown");

            if (searchInput && dropdown) {
                searchInput.addEventListener("input", function() {
                    var query = searchInput.value.trim();
                    if (query.length < 2) {
                        dropdown.innerHTML = "";
                        dropdown.style.display = "none";
                        return;
                    }

                    fetch('/Home/GetSearchSuggestions?query=' + encodeURIComponent(query))
                        .then(res => res.json())
                        .then(data => {
                            dropdown.innerHTML = "";
                            if (data.length === 0) {
                                dropdown.innerHTML = `<div class="p-2 text-muted small"><i class="bi bi-info-circle me-1"></i>Không tìm thấy thuốc khớp với từ khóa</div>`;
                                dropdown.style.display = "block";
                                return;
                            }

                            data.forEach(function(item) {
                                var imgUrl = item.hinhAnh || "";
                                if (!imgUrl) {
                                    var lowerName = item.tenThuoc.toLowerCase();
                                    if (lowerName.includes("panadol") || lowerName.includes("paracetamol")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Tylenol_Extra_Strength.jpg/500px-Tylenol_Extra_Strength.jpg";
                                    } else if (lowerName.includes("cetaphil")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Cetaphil_Daily_Facial_Cleanser.png/500px-Cetaphil_Daily_Facial_Cleanser.png";
                                    } else if (lowerName.includes("amoxicillin")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/0/07/Amoxicillin_500_mg_capsule.JPG/500px-Amoxicillin_500_mg_capsule.JPG";
                                    } else if (lowerName.includes("vitamin c")) {
                                        imgUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Ascorbic_acid_crystals.jpg/500px-Ascorbic_acid_crystals.jpg";
                                    } else {
                                        imgUrl = "https://via.placeholder.com/60x60?text=Thuoc";
                                    }
                                }

                                var priceFormatted = "";
                                if (item.isDeal) {
                                    priceFormatted = `<span class="text-danger fw-bold">${item.giaHienTai.toLocaleString('vi-VN')} đ</span> <span class="text-decoration-line-through text-muted" style="font-size: 0.7rem;">${item.donGia.toLocaleString('vi-VN')} đ</span>`;
                                } else {
                                    priceFormatted = `<span class="text-teal fw-bold">${item.donGia.toLocaleString('vi-VN')} đ</span>`;
                                }

                                var itemHtml = `
                                    <div class="suggestion-item d-flex align-items-center p-2 rounded" style="cursor: pointer; transition: background-color 0.2s;" onclick="selectSuggestion('${item.tenThuoc}')">
                                        <img src="${imgUrl}" alt="${item.tenThuoc}" class="rounded border" style="width: 40px; height: 40px; object-fit: contain; background: white;">
                                        <div class="ms-3 flex-grow-1 text-truncate">
                                            <div class="fw-bold text-dark small mb-0">${item.tenThuoc}</div>
                                            <span class="text-muted" style="font-size: 0.72rem;">${item.loaiThuoc} ${item.hoatChat ? ' • ' + item.hoatChat : ''}</span>
                                        </div>
                                        <div class="text-nowrap ms-2">${priceFormatted}</div>
                                    </div>
                                `;
                                dropdown.innerHTML += itemHtml;
                            });
                            dropdown.style.display = "block";
                        })
                        .catch(err => console.error("Error fetching suggestions:", err));
                });

                // Hide dropdown on clicking outside
                document.addEventListener("click", function(e) {
                    if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.style.display = "none";
                    }
                });

                // Trigger search on Enter key
                searchInput.addEventListener("keypress", function(e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        triggerSearch();
                    }
                });
            }
        });

        function selectSuggestion(name) {
            var searchInput = document.getElementById("topbarSearchInput");
            if (searchInput) {
                searchInput.value = name;
                document.getElementById("searchSuggestionsDropdown").style.display = "none";
                triggerSearch();
            }
        }

        function triggerSearch() {
            var searchInput = document.getElementById("topbarSearchInput");
            if (searchInput && searchInput.value.trim()) {
                window.location.href = '/Catalog/Index?cat=thuoc&loaiId=&query=' + encodeURIComponent(searchInput.value.trim());
            }
        }

        // Hook updateTopbarCounts to window so other views can refresh counts
        window.updateTopbarCounts = updateTopbarCounts;
    </script>

