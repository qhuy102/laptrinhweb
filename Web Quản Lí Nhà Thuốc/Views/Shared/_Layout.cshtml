@using Microsoft.AspNetCore.Identity
@using Web_Quản_Lí_Nhà_Thuốc.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lí Nhà Thuốc</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .suggestion-item:hover {
            background-color: #f1f5f9 !important;
        }
        .text-teal {
            color: #0d9488 !important;
        }
    </style>
</head>
<body>
    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")))
    {
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-brand">
                    <i class="bi bi-capsule"></i>
                    PharmaHub
                </a>
            </div>
            <ul class="sidebar-menu">
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a href="/" class="sidebar-link">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Tổng quan Admin</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/Users" class="sidebar-link">
                            <i class="bi bi-people"></i>
                            <span>Quản lý người dùng</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/Membership" class="sidebar-link">
                            <i class="bi bi-gem text-warning animate-pulse"></i>
                            <span>Quản lý Hội viên VIP</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/CreatePharmacist" class="sidebar-link">
                            <i class="bi bi-person-plus"></i>
                            <span>Tạo tài khoản Dược sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/AuditLogs" class="sidebar-link">
                            <i class="bi bi-shield-check"></i>
                            <span>Kiểm toán &amp; Logs</span>
                        </a>
                    </li>
                    <li class="sidebar-divider"><span>Quản lý Kho & Đơn Hàng</span></li>
                    <li>
                        <a href="/Category/Index" class="sidebar-link">
                            <i class="bi bi-tags"></i>
                            <span>Phân loại Thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Medicine/Index" class="sidebar-link">
                            <i class="bi bi-capsule-pill"></i>
                            <span>Quản lý Thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/Deals" class="sidebar-link">
                            <i class="bi bi-tag-fill"></i>
                            <span>Quản lý ưu đãi</span>
                        </a>
                    </li>

                    <li>
                        <a href="/OrderManagement/Index" class="sidebar-link">
                            <i class="bi bi-box-seam"></i>
                            <span>Quản lý Đơn hàng</span>
                        </a>
                    </li>

                    <!-- Admin cũng có thể truy cập trang Dược sĩ -->
                    <li class="sidebar-divider"><span>Chức năng Dược sĩ</span></li>
                    <li>
                        <a href="/Pharmacist/Dashboard" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Dược Sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Sell" class="sidebar-link">
                            <i class="bi bi-cart-plus"></i>
                            <span>Bán thuốc (POS)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Prescriptions" class="sidebar-link">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Quản lý Tư vấn</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Consult" class="sidebar-link">
                            <i class="bi bi-search"></i>
                            <span>Tư vấn thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Benh/Index" class="sidebar-link">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Quản lý Bệnh lý</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Pharmacist"))
                {
                    <li>
                        <a href="/Pharmacist/Dashboard" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Dược Sĩ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Sell" class="sidebar-link">
                            <i class="bi bi-cart-plus"></i>
                            <span>Bán thuốc (POS)</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Prescriptions" class="sidebar-link">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Quản lý Tư vấn</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Pharmacist/Consult" class="sidebar-link">
                            <i class="bi bi-search"></i>
                            <span>Tư vấn thuốc</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Benh/Index" class="sidebar-link">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Quản lý Bệnh lý</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>
    }

    <!-- Main Content -->
    <main class="main-content" style="@(SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")) ? "" : "margin-left: 0;")">
        <!-- Unified Top Toolbar -->
        <header class="topbar unified-toolbar">
            <div class="container d-flex align-items-center">
                <div class="left-group d-flex align-items-center">
                    <a class="navbar-brand d-flex align-items-center text-white fw-bold me-3" href="/">
                        <i class="bi bi-capsule me-2"></i>
                        <span class="brand-main">NHÀ THUỐC</span>
                        <span class="brand-accent ms-2 text-success">4 thằng trai</span>
                    </a>

                    <!-- Category dropdown button -->
                    <div class="dropdown d-none d-lg-block">
                        <button class="btn btn-category d-flex align-items-center" type="button" id="categoryDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill me-2"></i>
                            <span class="fw-semibold">Danh mục</span>
                            <i class="bi bi-caret-down-fill ms-2"></i>
                        </button>
                        <div class="dropdown-menu p-3 shadow-lg border-0 category-mega-dropdown" aria-labelledby="categoryDropdown" style="width: 580px; border-radius: 16px;">
                            <div class="row g-2">
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index">
                                        <div class="category-icon-wrapper icon-primary rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-grid-3x3-gap-fill fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Tất cả danh mục</div>
                                            <div class="text-muted small-desc">Khám phá toàn bộ sản phẩm</div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index?cat=thuoc">
                                        <div class="category-icon-wrapper icon-teal rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-capsule-pill fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Thuốc</div>
                                            <div class="text-muted small-desc">Thuốc kê đơn và không kê đơn</div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index?cat=tracuu">
                                        <div class="category-icon-wrapper icon-danger rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-heart-pulse fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Tra cứu bệnh</div>
                                            <div class="text-muted small-desc">Tra cứu thông tin và cách điều trị</div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index?cat=tpcn">
                                        <div class="category-icon-wrapper icon-success rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-shield-heart fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Thực phẩm bảo vệ sức khỏe</div>
                                            <div class="text-muted small-desc">Vitamin & Thực phẩm chức năng</div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index?cat=me-be">
                                        <div class="category-icon-wrapper icon-info rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-baby-carriage fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Mẹ và bé</div>
                                            <div class="text-muted small-desc">Sản phẩm cho mẹ bầu và trẻ nhỏ</div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index?cat=thietbiyte">
                                        <div class="category-icon-wrapper icon-warning rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-thermometer-half fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Thiết bị y tế</div>
                                            <div class="text-muted small-desc">Máy đo huyết áp, nhiệt kế, thiết bị...</div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="dropdown-item d-flex align-items-center p-3 h-100" href="/Catalog/Index?cat=sanpham-tien-loi">
                                        <div class="category-icon-wrapper icon-secondary rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                            <i class="bi bi-box-seam fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Sản phẩm tiện lợi</div>
                                            <div class="text-muted small-desc">Khẩu trang, nước rửa tay, hóa mỹ phẩm</div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="center-nav d-none d-lg-flex justify-content-center flex-grow-1">
                    <ul class="nav toolbar-links">
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=thuoc">Thuốc</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=tracuu">Tra cứu bệnh</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=tpcn">Thực phẩm bảo vệ sức khỏe</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Catalog/Index?cat=me-be">Mẹ và bé</a></li>
                    </ul>
                </div>

                <div class="right-group d-flex align-items-center ms-auto gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="notification-btn position-relative me-2" style="cursor: pointer;" onclick="window.location.href='/Order/MyOrders'">
                            <i class="bi bi-bell text-white fs-5"></i>
                            <span id="notificationBadge" class="notification-badge" style="display: none;">0</span>
                        </div>

                        <a href="/Cart" class="btn btn-link text-white position-relative me-2">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span id="cartBadge" class="notification-badge" style="display: none;">0</span>
                        </a>
                    }
                    else
                    {
                        <div class="notification-btn position-relative me-2" style="cursor: pointer;" onclick="window.location.href='/Identity/Account/Login?ReturnUrl=%2FOrder%2FMyOrders'">
                            <i class="bi bi-bell text-white fs-5"></i>
                            <span id="notificationBadge" class="notification-badge" style="display: none;">0</span>
                        </div>

                        <a href="/Identity/Account/Login?ReturnUrl=%2FCart" class="btn btn-link text-white position-relative me-2">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span id="cartBadge" class="notification-badge" style="display: none;">0</span>
                        </a>
                    }

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="user-menu dropdown">
                            <button class="btn user-avatar-btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar me-2"><i class="bi bi-person-circle"></i></div>
                                <span class="user-name d-none d-md-inline">@(currentUser?.HoTen ?? User.Identity?.Name)</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 12px; min-width: 250px;">
                                <li>
                                    <a class="dropdown-item py-2" href="/Identity/Account/Manage">
                                        <i class="bi bi-person me-2"></i>
                                        Hồ sơ cá nhân
                                    </a>
                                </li>

                                @if (!User.IsInRole("Admin") && !User.IsInRole("Pharmacist"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 text-warning fw-bold" href="/User/MembershipUpgrade">
                                            <i class="bi bi-gem me-2 text-warning"></i>
                                            Nâng cấp Hội viên VIP
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="/User/Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/Order/MyOrders">
                                            <i class="bi bi-bag-check me-2"></i>
                                            Đơn hàng của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/Cart">
                                            <i class="bi bi-cart3 me-2"></i>
                                            Giỏ hàng
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" href="/User/Favorites">
                                            <i class="bi bi-heart me-2"></i>
                                            Sản phẩm yêu thích
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Identity/Account/Login" class="btn btn-outline-light btn-sm rounded-pill px-3">Đăng nhập</a>
                        <a href="/Identity/Account/Login" class="btn btn-primary btn-sm rounded-pill px-3">Đăng ký</a>
                    }
                </div>
            </div>
        </header>

        <!-- Search bar below unified toolbar -->
        <div class="container py-3">
            <div class="input-group shadow-sm rounded-pill mx-auto position-relative" style="max-width:920px; z-index: 1000;">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                <div class="flex-grow-1 position-relative">
                    <input type="text" id="topbarSearchInput" class="form-control border-0 autocomplete-input" placeholder="Tìm kiếm thuốc, bệnh, thành phần..." autocomplete="off">
                    <div id="searchSuggestionsDropdown" class="suggestions-dropdown shadow rounded-3 bg-white position-absolute w-100 mt-2 p-2" style="display: none; z-index: 1050; border: 1px solid #cbd5e1; max-height: 350px; overflow-y: auto;"></div>
                </div>
                <button class="btn btn-primary rounded-end px-4" onclick="triggerSearch()">Tìm kiếm</button>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>

        <!-- Pharmacy Footer -->
        <footer class="site-footer">
            <div class="footer-top">
                <div class="container">
                    <div class="row g-4">
                        <!-- Column 1: Brand Info & Certification -->
                        <div class="col-lg-4 col-md-6">
                            <div class="footer-brand mb-3">
                                <a href="/" class="d-flex align-items-center text-decoration-none">
                                    <i class="bi bi-capsule fs-3 text-teal me-2"></i>
                                    <span class="brand-text fw-bold text-dark fs-4">NHÀ THUỐC <span class="text-teal">4 chàng trai</span></span>
                                </a>
                            </div>
                            <p class="footer-desc text-muted mb-4">
                                Hệ thống nhà thuốc PharmaHub - Cung cấp thuốc, thực phẩm chức năng, thiết bị y tế chính hãng và tư vấn chăm sóc sức khỏe trực tuyến từ dược sĩ chuyên môn cao.
                            </p>
                            <div class="certification-badges d-flex gap-2 align-items-center flex-wrap">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1.5 rounded" style="font-weight: 500; font-size: 0.75rem;"><i class="bi bi-shield-check me-1"></i>Đạt chuẩn GPP</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1.5 rounded" style="font-weight: 500; font-size: 0.75rem;"><i class="bi bi-file-earmark-medical me-1"></i>Bộ Y Tế Cấp Phép</span>
                            </div>
                        </div>

                        <!-- Column 2: Quick Links / Categories -->
                        <div class="col-lg-2 col-md-6 col-6">
                            <h5 class="footer-title fw-bold text-dark mb-3">Danh mục nổi bật</h5>
                            <ul class="footer-links list-unstyled">
                                <li><a href="/Catalog/Index?cat=thuoc"><i class="bi bi-chevron-right me-1"></i>Thuốc kê đơn</a></li>
                                <li><a href="/Catalog/Index?cat=tpcn"><i class="bi bi-chevron-right me-1"></i>Thực phẩm chức năng</a></li>
                                <li><a href="/Catalog/Index?cat=me-be"><i class="bi bi-chevron-right me-1"></i>Mẹ và bé</a></li>
                                <li><a href="/Catalog/Index?cat=thietbiyte"><i class="bi bi-chevron-right me-1"></i>Thiết bị y tế</a></li>
                                <li><a href="/Catalog/Index?cat=tracuu"><i class="bi bi-chevron-right me-1"></i>Tra cứu bệnh</a></li>
                            </ul>
                        </div>

                        <!-- Column 3: Customer Policies / Support -->
                        <div class="col-lg-3 col-md-6 col-6">
                            <h5 class="footer-title fw-bold text-dark mb-3">Chính sách & Hỗ trợ</h5>
                            <ul class="footer-links list-unstyled">
                                <li><a href="/Home/Policies?tab=delivery"><i class="bi bi-chevron-right me-1"></i>Chính sách giao hàng</a></li>
                                <li><a href="/Home/Policies?tab=return"><i class="bi bi-chevron-right me-1"></i>Chính sách đổi trả thuốc</a></li>
                                <li><a href="/Home/Policies?tab=privacy"><i class="bi bi-chevron-right me-1"></i>Chính sách bảo mật</a></li>
                                <li><a href="/Home/PrescriptionUpload"><i class="bi bi-chevron-right me-1"></i>Tư vấn với bác sĩ</a></li>
                            </ul>
                        </div>

                        <!-- Column 4: Contact Info & Hotline -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="footer-title fw-bold text-dark mb-3">Thông tin liên hệ</h5>
                            <ul class="footer-contact list-unstyled">
                                <li class="d-flex align-items-start mb-3">
                                    <i class="bi bi-geo-alt-fill text-teal me-2 mt-1"></i>
                                    <span class="text-muted">123 Đường Ba Tháng Hai, Phường 11, Quận 10, TP. Hồ Chí Minh</span>
                                </li>
                                <li class="d-flex align-items-center mb-3">
                                    <i class="bi bi-telephone-fill text-teal me-2"></i>
                                    <div>
                                        <span class="text-muted d-block small">Hotline tư vấn (24/7)</span>
                                        <a href="tel:18006000" class="text-dark fw-bold text-decoration-none">1800 6000 (Miễn phí)</a>
                                    </div>
                                </li>
                                <li class="d-flex align-items-center mb-3">
                                    <i class="bi bi-envelope-fill text-teal me-2"></i>
                                    <a href="mailto:support@pharmahub.vn" class="text-muted text-decoration-none">support@pharmahub.vn</a>
                                </li>
                            </ul>
                            <div class="footer-socials d-flex gap-2 mt-3">
                                <a href="#" class="social-icon facebook-icon" title="Facebook"><i class="bi bi-facebook"></i></a>
                                <a href="#" class="social-icon youtube-icon" title="Youtube"><i class="bi bi-youtube"></i></a>
                                <a href="#" class="social-icon chat-icon" title="Zalo"><i class="bi bi-chat-text-fill"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <p class="mb-0 text-muted small">
                        &copy; 2026 Nhà Thuốc PharmaHub. Tất cả quyền được bảo lưu.
                    </p>
                    <div class="payment-methods d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small me-2">Chấp nhận thanh toán</span>
                        <div class="payment-badge" title="Visa"><i class="bi bi-credit-card-2-front"></i> Visa</div>
