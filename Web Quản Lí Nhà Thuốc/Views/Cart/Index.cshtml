@model IEnumerable<Web_Quản_Lí_Nhà_Thuốc.Models.GioHang>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2 class="mb-4">🛒 Giỏ hàng</h2>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Thuốc</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Thuoc.TenThuoc</td>

                <td>
                    @item.Thuoc.DonGia.ToString("N0") đ
                </td>

                <td>
                    @item.SoLuong
                </td>

                <td>
                    @((item.Thuoc.DonGia * item.SoLuong).ToString("N0")) đ
                </td>

                <td>
                    <a asp-action="Remove"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>

<a asp-controller="Order"
   asp-action="Checkout"
   class="btn btn-success">
    Thanh toán
</a>