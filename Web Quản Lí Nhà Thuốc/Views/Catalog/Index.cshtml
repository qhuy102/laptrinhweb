	<script>
		let activeWellnessGoal = 'All';

		function filterByWellness(goal, element) {
			activeWellnessGoal = goal;
			
			// Highlight selected card
			document.querySelectorAll('.wellness-goal-card').forEach(card => {
				card.classList.remove('active');
			});
			if (element) {
				element.classList.add('active');
			} else {
				let targetId = 'goal_All';
				if (goal === 'Tăng đề kháng & Miễn dịch') targetId = 'goal_dekhang';
				else if (goal === 'Bổ não & Giảm căng thẳng') targetId = 'goal_naobo';
				else if (goal === 'Bổ mắt & Tim mạch') targetId = 'goal_mat';
				else if (goal === 'Xương khớp chắc khỏe') targetId = 'goal_xuongkhop';
				else if (goal === 'Hỗ trợ tiêu hóa') targetId = 'goal_tieuhoa';
				else if (goal === 'Đẹp da & Chống lão hóa') targetId = 'goal_lamdep';
				
				const el = document.getElementById(targetId);
				if (el) el.classList.add('active');
			}

			// Filter products grid
			const items = document.querySelectorAll('#tpcnProductGrid .product-item-card');
			let visibleCount = 0;

			items.forEach(function(item) {
				const treatmentGroup = item.dataset.treatment || '';
				const matchGoal = (activeWellnessGoal === 'All' || treatmentGroup === activeWellnessGoal);

				if (matchGoal) {
					item.style.display = 'block';
					visibleCount++;
				} else {
					item.style.display = 'none';
				}
			});

			// Update result text
			const countTextEl = document.getElementById('tpcnResultCount');
			if (countTextEl) {
				countTextEl.innerText = `Hiển thị ${visibleCount} sản phẩm phù hợp`;
			}

			// Handle empty message
			const existingEmptyMsg = document.getElementById('noTpcnFilteredProductsMessage');
			if (visibleCount === 0) {
				if (!existingEmptyMsg) {
					const grid = document.getElementById('tpcnProductGrid');
					const msgHtml = `
						<div id="noTpcnFilteredProductsMessage" class="col-12 text-center py-5 bg-white rounded-4 border w-100 shadow-3xs mt-3">
							<div class="text-muted mb-3"><i class="bi bi-search fs-2 text-success"></i></div>
							<h6 class="fw-bold text-dark">Chưa có sản phẩm bổ trợ cho nhu cầu này</h6>
							<p class="text-muted small">Hãy liên hệ với Dược sĩ của chúng tôi để nhận tư vấn phù hợp nhất.</p>
						</div>
					`;
					grid.insertAdjacentHTML('beforeend', msgHtml);
				} else {
					existingEmptyMsg.style.display = 'block';
				}
			} else {
				if (existingEmptyMsg) existingEmptyMsg.style.display = 'none';
			}
		}

		function resetWellnessFilter() {
			filterByWellness('All', document.getElementById('goal_All'));
			const problemSelect = document.getElementById('assistantProblemSelect');
			if (problemSelect) problemSelect.value = 'All';
		}

		function runAssistantSelection() {
			const selectEl = document.getElementById('assistantProblemSelect');
			if (!selectEl) return;
			const problem = selectEl.value;

			if (problem === 'All') {
				resetWellnessFilter();
				return;
			}

			let mapping = 'All';
			if (problem === 'dekhang') mapping = 'Tăng đề kháng & Miễn dịch';
			else if (problem === 'naobo') mapping = 'Bổ não & Giảm căng thẳng';
			else if (problem === 'mat') mapping = 'Bổ mắt & Tim mạch';
			else if (problem === 'xuongkhop') mapping = 'Xương khớp chắc khỏe';
			else if (problem === 'tieuhoa') mapping = 'Hỗ trợ tiêu hóa';
			else if (problem === 'lamdep') mapping = 'Đẹp da & Chống lão hóa';

			filterByWellness(mapping, null);
		}
	</script>
