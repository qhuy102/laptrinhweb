		.category-sidebar-link:hover {
			background-color: #f8fafc;
			color: #0d9488;
			transform: translateX(3px);
		}
		.category-sidebar-link.active {
			background-color: #0d9488 !important;
			color: white !important;
			font-weight: 600;
			box-shadow: 0 4px 12px rgba(13, 148, 136, 0.15);
		}
		.category-sidebar-link.active i {
			color: white !important;
		}
		.catalog-hero {
			background: linear-gradient(135deg, #0d9488 0%, #3b82f6 100%);
			box-shadow: 0 10px 30px rgba(13, 148, 136, 0.1) !important;
		}
		.search-toolbar-wrapper .input-group-focus {
			border-color: rgba(13, 148, 136, 0.4) !important;
			box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.1) !important;
		}
		.product-item-card {
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}
		.product-item-card:hover {
			transform: translateY(-5px);
		}
	</style>

	<div class="container mt-4">
		<!-- Hero section for Thuốc -->
		<div class="catalog-hero text-white rounded-4 p-5 mb-4 shadow-sm overflow-hidden position-relative">
			<div class="hero-content position-relative" style="z-index: 2; max-width: 700px;">
				<span class="badge text-white rounded-pill px-3 py-2 mb-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.8rem; backdrop-filter: blur(5px); background-color: rgba(255, 255, 255, 0.25);">
					Nhà Thuốc Chính Hãng GPP
				</span>
				<h1 class="display-5 fw-bold mb-3">Danh Mục Thuốc & Dược Phẩm</h1>
				<p class="lead text-white text-opacity-90 mb-0">Cam kết 100% thuốc chính hãng, được bảo quản trong điều kiện chuẩn nhiệt độ và độ ẩm, phục vụ tư vấn tận tâm bởi đội ngũ Dược sĩ giàu kinh nghiệm.</p>
			</div>
			<div style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-image: radial-gradient(circle at 85% 30%, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 50%); pointer-events: none;"></div>
		</div>

		<div class="row">
			<!-- Sidebar: Categories -->
			<div class="col-lg-3 mb-4">
				<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: hidden;">
					<div class="card-header bg-white border-0 pt-4 px-4 pb-2">
						<h6 class="fw-bold mb-0 text-dark d-flex align-items-center">
							<i class="bi bi-grid-fill text-teal me-2"></i>
							Phân loại dược phẩm
						</h6>
					</div>
					<div class="card-body px-3 py-2">
						<ul class="list-unstyled mb-0">
							<li class="mb-1">
								<a class="category-sidebar-link d-flex align-items-center justify-content-between p-2.5 rounded-3 text-decoration-none @(string.IsNullOrEmpty(activeLoaiId) ? "active" : "")" href="/Catalog/Index?cat=thuoc">
									<span class="d-flex align-items-center">
										<i class="bi bi-grid-3x3-gap-fill me-2 fs-6 text-teal"></i>
										Tất cả sản phẩm
									</span>
									<i class="bi bi-chevron-right fs-7 opacity-50"></i>
								</a>
							</li>
							@if (allCats != null)
							{
								foreach(var c in allCats) {
									var isCurrent = c.Id.ToString() == activeLoaiId;
									<li class="mb-1">
										<a class="category-sidebar-link d-flex align-items-center justify-content-between p-2.5 rounded-3 text-decoration-none @(isCurrent ? "active" : "")" href="/Catalog/Index?cat=thuoc&loaiId=@c.Id">
											<span class="d-flex align-items-center">
												<i class="bi bi-capsule-pill me-2 fs-6 text-teal"></i>
												@c.TenLoai
											</span>
											<i class="bi bi-chevron-right fs-7 opacity-50"></i>
										</a>
									</li>
								}
							}
						</ul>
					</div>
				</div>

				<div class="card border-0 shadow-sm p-4 text-center bg-white" style="border-radius: 16px; background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%) !important;">
					<div class="text-teal fs-3 mb-2"><i class="bi bi-file-earmark-medical"></i></div>
					<h6 class="fw-bold mb-1">Có đơn thuốc của bác sĩ?</h6>
					<p class="text-muted small mb-3">Tải đơn thuốc lên để Dược sĩ liên hệ chuẩn bị thuốc và giao tận nơi.</p>
					<a href="/Home/PrescriptionUpload" class="btn btn-teal-btn btn-sm rounded-pill w-100 py-2">Gửi đơn thuốc</a>
				</div>
			</div>

			<!-- Main product grid -->
			<div class="col-lg-9">
				<!-- Search and filter toolbar -->
				<div class="card border-0 shadow-sm p-3 bg-white mb-4 search-toolbar-wrapper" style="border-radius: 16px;">
					<form method="get" action="/Catalog/Index" class="row g-2 align-items-center">
						<input type="hidden" name="cat" value="thuoc" />
						<input type="hidden" name="loaiId" value="@activeLoaiId" />
						<div class="col-md-8 col-12">
							<div class="input-group border rounded-pill overflow-hidden bg-light">
								<span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
								<input type="text" name="query" class="form-control border-0 bg-transparent" placeholder="Tìm kiếm thuốc trong danh mục..." value="@activeQuery" style="box-shadow: none; height: 42px;">
							</div>
						</div>
						<div class="col-md-4 col-12 d-flex gap-2 justify-content-md-end">
							<button class="btn btn-teal-btn rounded-pill px-4 flex-grow-1" type="submit" style="height: 42px;">Tìm kiếm</button>
							@if (!string.IsNullOrEmpty(activeQuery) || !string.IsNullOrEmpty(activeLoaiId))
							{
								<a href="/Catalog/Index?cat=thuoc" class="btn btn-outline-secondary rounded-pill d-flex align-items-center justify-content-center px-3" style="height: 42px;" title="Xóa bộ lọc">
									<i class="bi bi-x-lg"></i>
								</a>
							}
						</div>
					</form>
				</div>

				<div class="d-flex justify-content-between align-items-center mb-3">
					<div>
						<h4 class="fw-bold text-dark mb-0">@activeCategoryName</h4>
						<p class="text-muted small mb-0">Hiển thị @(Model?.Count() ?? 0) sản phẩm phù hợp</p>
					</div>
					@if (!string.IsNullOrEmpty(activeQuery))
					{
						<span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Từ khóa: "@activeQuery"</span>
					}
				</div>

				@if (Model != null && Model.Any()) {
					<div class="row g-3" id="productGrid">
						@foreach(var p in Model) {
							<div class="col-6 col-md-4 col-lg-3 product-item-card">
								@await Html.PartialAsync("~/Views/Shared/_ProductCard.cshtml", p)
							</div>
						}
					</div>
				}
				else {
					<div class="row">
						<div class="col-12 text-center py-5 bg-white rounded-4 border shadow-sm">
							<div class="text-muted mb-3">
								<i class="bi bi-search fs-1 text-teal" style="opacity: 0.6;"></i>
							</div>
							<h5 class="fw-bold text-dark">Không tìm thấy sản phẩm nào</h5>
							<p class="text-muted small">Chúng tôi chưa có sẵn sản phẩm trong phân loại này hoặc khớp với từ khóa tìm kiếm của bạn.</p>
							<a href="/Catalog/Index?cat=thuoc" class="btn btn-teal-btn px-4 py-2 rounded-pill mt-2">Xem tất cả thuốc</a>
						</div>
					</div>
				}
			</div>
		</div>

		@await Html.PartialAsync("~/Views/Shared/_ProductScripts.cshtml")
	</div>
}

