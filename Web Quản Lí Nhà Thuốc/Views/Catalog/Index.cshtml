							<p class="text-muted small">Vui lòng liên hệ Dược sĩ để nhận hỗ trợ chọn sản phẩm thay thế.</p>
						</div>
					`;
					grid.insertAdjacentHTML('beforeend', msgHtml);
				} else {
					existingEmptyMsg.style.display = 'block';
				}
			} else {
				if (existingEmptyMsg) existingEmptyMsg.style.display = 'none';
			}
		}

		function resetMeBeFilter() {
			filterByMeBe('All', document.getElementById('mebe_All'));
		}
	</script>
