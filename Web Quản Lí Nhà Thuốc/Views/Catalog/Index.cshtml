@model IEnumerable<Web_Quản_Lí_Nhà_Thuốc.Models.Thuoc>

@{
	ViewData["Title"] = ViewData["CategoryTitle"] ?? "Danh mục";
}

<div class="container mt-4">
	<div class="row">
		<div class="col-lg-3 mb-4">
			<div class="category-sidebar p-3 rounded shadow-sm">
				<h6 class="fw-bold mb-2">Danh mục thuốc</h6>
				<ul class="list-unstyled mb-0">
					<li><a class="d-block py-2" href="/Catalog/Index?cat=thuoc">Tất cả</a></li>
					@if (ViewData["AllCategories"] is IEnumerable<Web_Quản_Lí_Nhà_Thuốc.Models.LoaiThuoc> cats)
					{
						foreach(var c in cats) {
							<li><a class="d-block py-2" href="/Catalog/Index?cat=thuoc&loaiId=@c.Id">@c.TenLoai</a></li>
						}
					}
				</ul>
			</div>
		</div>

		<div class="col-lg-9">
			<div class="d-flex justify-content-between align-items-end mb-3">
				<div>
					<h2 class="fw-bold text-dark mb-1">@ViewData["CategoryTitle"]</h2>
					<p class="text-muted small mb-0">@ViewData["CategoryDescription"]</p>
				</div>
				<a href="#" class="text-teal fw-semibold text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
			</div>

			@if (Model != null && Model.Any()) {
				<div class="row g-3">
					@foreach(var p in Model) {
						<div class="col-6 col-md-4 col-lg-3">
							@await Html.PartialAsync("~/Views/Shared/_ProductCard.cshtml", p)
						</div>
					}
				</div>
			}
			else {
				<div class="alert alert-secondary">Không có sản phẩm cho danh mục này.</div>
			}
		</div>
	</div>

	@await Html.PartialAsync("~/Views/Shared/_ProductScripts.cshtml")
</div>
