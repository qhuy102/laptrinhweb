	<script>
		let activeMeBeGoal = 'All';

		function filterByMeBe(goal, element) {
			activeMeBeGoal = goal;
			
			// Highlight selected card
			document.querySelectorAll('.mebe-card').forEach(card => {
				card.classList.remove('active');
			});
			if (element) {
				element.classList.add('active');
			} else {
				let targetId = 'mebe_All';
				if (goal === 'Trẻ sơ sinh (0 - 6 tháng)') targetId = 'mebe_sosinhi';
				else if (goal === 'Dành cho Mẹ bầu') targetId = 'mebe_mebau';
				
				const el = document.getElementById(targetId);
				if (el) el.classList.add('active');
			}

			// Filter grid
			const items = document.querySelectorAll('#mebeProductGrid .product-item-card');
			let visibleCount = 0;

			items.forEach(function(item) {
				const treatmentGroup = item.dataset.treatment || '';
				const matchGoal = (activeMeBeGoal === 'All' || treatmentGroup === activeMeBeGoal);

				if (matchGoal) {
					item.style.display = 'block';
					visibleCount++;
				} else {
					item.style.display = 'none';
				}
			});

			const countTextEl = document.getElementById('mebeResultCount');
			if (countTextEl) {
				countTextEl.innerText = `Hiển thị ${visibleCount} sản phẩm phù hợp`;
			}

			const existingEmptyMsg = document.getElementById('noMebeFilteredProductsMessage');
			if (visibleCount === 0) {
				if (!existingEmptyMsg) {
					const grid = document.getElementById('mebeProductGrid');
					const msgHtml = `
						<div id="noMebeFilteredProductsMessage" class="col-12 text-center py-5 bg-white rounded-4 border w-100 shadow-3xs mt-3">
							<div class="text-muted mb-3"><i class="bi bi-search fs-2 text-danger"></i></div>
