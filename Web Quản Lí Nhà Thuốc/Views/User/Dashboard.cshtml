@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2>
                Xin chào @User.Identity.Name 👋
            </h2>

            <p class="text-muted mb-0">
                Chào mừng quay trở lại PharmaCare
            </p>
        </div>
    </div>

    <div class="row">

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-bag-check fs-1 text-success"></i>
                    <h5 class="mt-2">Tổng đơn hàng</h5>
                    <h3>12</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-truck fs-1 text-primary"></i>
                    <h5 class="mt-2">Đang giao</h5>
                    <h3>2</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-heart-fill fs-1 text-danger"></i>
                    <h5 class="mt-2">Yêu thích</h5>
                    <h3>8</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-award fs-1 text-warning"></i>
                    <h5 class="mt-2">Điểm thưởng</h5>
                    <h3>150</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-8">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Đơn hàng gần đây
                    </h5>
                </div>

                <div class="card-body">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Trạng thái</th>
                                <th>Tổng tiền</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>#DH001</td>
                                <td>10/06/2026</td>
                                <td>
                                    <span class="badge bg-success">
                                        Hoàn thành
                                    </span>
                                </td>
                                <td>150.000đ</td>
                            </tr>

                            <tr>
                                <td>#DH002</td>
                                <td>12/06/2026</td>
                                <td>
                                    <span class="badge bg-warning">
                                        Đang giao
                                    </span>
                                </td>
                                <td>320.000đ</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Thông tin tài khoản
                    </h5>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Email:</strong><br />
                        @User.Identity.Name
                    </p>

                    <p>
                        <strong>Hạng thành viên:</strong><br />
                        Gold Member
                    </p>

                    <p>
                        <strong>Điểm tích lũy:</strong><br />
                        150 điểm
                    </p>

                </div>
            </div>

        </div>

    </div>

</div>