@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaAdmin</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1>Đăng nhập</h1>
                <p>Vui lòng đăng nhập tài khoản của bạn để tiếp tục.</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                
                <div class="form-group">
                    <input asp-for="Input.Email" class="input-styled" autocomplete="username" aria-required="true" placeholder="Địa chỉ Email" />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Input.Password" type="password" class="input-styled" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu" />
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label text-muted" style="font-size: 0.85rem;" asp-for="Input.RememberMe">
                            Ghi nhớ tài khoản
                        </label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary text-decoration-none" style="font-size: 0.85rem; font-weight: 500;">Quên mật khẩu?</a>
                </div>

                <button id="login-submit" type="submit" class="btn-primary-styled">Đăng nhập</button>
            </form>

            <div class="login-footer">
                Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
            </div>
        </div>
        
        <div class="text-center mt-4">
            <a href="/" class="text-muted text-decoration-none" style="font-size: 0.875rem;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
            </a>
        </div>
    </div>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
