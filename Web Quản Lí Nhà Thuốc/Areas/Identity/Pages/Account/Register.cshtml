@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaAdmin</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1>Tạo tài khoản</h1>
                <p>Đăng ký để trở thành thành viên và nhận nhiều ưu đãi hấp dẫn.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                
                <div class="form-group">
                    <input asp-for="Input.HoTen" class="input-styled" autocomplete="name" aria-required="true" placeholder="Họ và tên" />
                    <span asp-validation-for="Input.HoTen" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.NgaySinh" class="text-muted ms-2 mb-1" style="font-size: 0.75rem;">Ngày sinh</label>
                    <input asp-for="Input.NgaySinh" type="date" class="input-styled" aria-required="true" />
                    <span asp-validation-for="Input.NgaySinh" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Input.Email" class="input-styled" autocomplete="username" aria-required="true" placeholder="Email" />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-group">
                        <div class="form-group">
                            <input asp-for="Input.Password" type="password" class="input-styled" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu" />
                            <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-group">
                        <div class="form-group">
                            <input asp-for="Input.ConfirmPassword" type="password" class="input-styled" autocomplete="new-password" aria-required="true" placeholder="Xác nhận" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>
                </div>

                <button id="registerSubmit" type="submit" class="btn-primary-styled">Đăng ký ngay</button>
            </form>

            <div class="divider">hoặc đăng ký bằng</div>

            <div class="social-logins">
                <div class="social-btn zalo">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
                <div class="social-btn facebook">
                    <i class="bi bi-facebook"></i>
                </div>
                <div class="social-btn google">
                    <i class="bi bi-google"></i>
                </div>
            </div>

            <div class="login-footer">
                Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a>
            </div>
        </div>
        
        <div class="text-center mt-4">
            <a href="/" class="text-muted text-decoration-none" style="font-size: 0.875rem;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
            </a>
        </div>
    </div>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
